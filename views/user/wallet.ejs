<%- include('../layouts/header.ejs') %>

<style>
  .top-nav-bar {
    background: white;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    padding: 15px 0;
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  .top-nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .nav-logo img {
    height: 35px;
  }

  .nav-icons {
    display: flex;
    gap: 30px;
    align-items: center;
  }

  .nav-icon-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: #333;
    transition: all 0.3s ease;
  }

  .nav-icon-item:hover {
    color: #111827;
    transform: translateY(-2px);
  }

  .nav-icon-wrapper {
    position: relative;
    font-size: 24px;
  }

  .nav-icon-label {
    font-size: 12px;
    margin-top: 4px;
    font-weight: 500;
  }

  body {
    background: #f5f5f7;
  }

  .wallet-container {
    max-width: 1200px;
    margin: 30px auto;
    padding: 0 20px;
  }

  .balance-card {
    background: linear-gradient(135deg, #ffffff 0%, #9197af 100%);
    color: white;
    border-radius: 16px;
    padding: 40px;
    margin-bottom: 30px;
    box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
  }

  .balance-label {
    font-size: 14px;
    opacity: 0.9;
    margin-bottom: 10px;
  }

  .balance-amount {
    font-size: 48px;
    font-weight: 700;
    margin: 0;
  }

  .transactions-card {
    background: white;
    border-radius: 12px;
    padding: 30px;
    border: 1px solid #e5e7eb;
  }

  .transactions-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 25px;
    padding-bottom: 20px;
    border-bottom: 2px solid #f3f4f6;
  }

  .transactions-title {
    font-size: 22px;
    font-weight: 700;
    color: #111827;
    margin: 0;
  }

  .search-box {
    position: relative;
    max-width: 300px;
  }

  .search-box input {
    width: 100%;
    padding: 10px 40px 10px 15px;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    font-size: 14px;
  }

  .search-box input:focus {
    outline: none;
    border-color: #667eea;
  }

  .search-box i {
    position: absolute;
    right: 15px;
    top: 50%;
    transform: translateY(-50%);
    color: #9ca3af;
  }

  .transactions-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
  }

  .transactions-table thead {
    background: #f9fafb;
  }

  .transactions-table th {
    padding: 15px;
    text-align: left;
    font-size: 12px;
    font-weight: 700;
    color: #6b7280;
    text-transform: uppercase;
    border-bottom: 2px solid #e5e7eb;
  }

  .transactions-table td {
    padding: 18px 15px;
    border-bottom: 1px solid #f3f4f6;
    color: #374151;
  }

  .transactions-table tbody tr:hover {
    background: #f9fafb;
  }

  .transaction-id {
    font-family: monospace;
    font-size: 13px;
    color: #6b7280;
  }

  .transaction-amount {
    font-weight: 600;
    color: #111827;
  }

  .transaction-badge {
    display: inline-block;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
  }

  .badge-credit {
    background: #d1fae5;
    color: #065f46;
  }

  .badge-debit {
    background: #fee2e2;
    color: #991b1b;
  }

  .empty-state {
    text-align: center;
    padding: 60px 20px;
  }

  .empty-state i {
    font-size: 64px;
    color: #d1d5db;
    margin-bottom: 20px;
  }

  .empty-state h3 {
    font-size: 20px;
    color: #6b7280;
    margin-bottom: 10px;
  }

  @media (max-width: 768px) {
    .nav-logo img {
      height: 28px;
    }

    .nav-icon-label {
      display: none;
    }

    .balance-card {
      padding: 30px 20px;
    }

    .balance-amount {
      font-size: 36px;
    }

    .transactions-card {
      padding: 20px 15px;
      overflow-x: auto;
    }

    .transactions-header {
      flex-direction: column;
      gap: 15px;
      align-items: flex-start;
    }

    .search-box {
      width: 100%;
      max-width: 100%;
    }

    .transactions-table {
      min-width: 600px;
    }

    .transactions-table th,
    .transactions-table td {
      padding: 12px 10px;
      font-size: 13px;
    }
  }
</style>

<!-- Top Navigation -->
<nav class="top-nav-bar">
  <div class="top-nav-container">
    <a href="/" class="nav-logo">
      <img src="assets/newimages/logo.png" alt="shopEazy Logo">
    </a>

    <div class="nav-icons">
      <a href="/wishlist" class="nav-icon-item">
        <div class="nav-icon-wrapper">
          <i class="icon-heart-o"></i>
        </div>
        <span class="nav-icon-label">Wishlist</span>
      </a>

      <a href="/cart" class="nav-icon-item">
        <div class="nav-icon-wrapper">
          <i class="icon-shopping-cart"></i>
        </div>
        <span class="nav-icon-label">Cart</span>
      </a>

      <a href="/dashboard" class="nav-icon-item">
        <div class="nav-icon-wrapper">
          <i class="icon-user"></i>
        </div>
        <span class="nav-icon-label">Account</span>
      </a>
    </div>
  </div>
</nav>

<!-- Wallet Content -->
<div class="wallet-container">
  <!-- Balance Card -->
  <div class="balance-card">
    <p class="balance-label">Current Balance</p>
    <h2 class="balance-amount">
      ₹<%= wallet && wallet[0]?.balance ? wallet[0].balance.toFixed(2) : '0.00' %>
    </h2>
  </div>

  <!-- Transactions Card -->
  <div class="transactions-card">
    <div class="transactions-header">
      <h2 class="transactions-title">Transaction History</h2>
      <div class="search-box">
        <input type="text" id="searchInput" placeholder="Search transactions...">
        <i class="icon-search"></i>
      </div>
    </div>

    <% if (wallet && wallet[0]?.history && wallet[0].history.length > 0) { %>
      <div style="overflow-x: auto;">
        <table class="transactions-table">
          <thead>
            <tr>
              <th>Transaction ID</th>
              <th>Date</th>
              <th>Description</th>
              <th>Amount</th>
              <th>Type</th>
            </tr>
          </thead>
          <tbody id="transactionsBody">
            <% wallet[0].history.forEach(hist => { %>
              <tr>
                <td class="transaction-id">#<%= hist.transaction_id %></td>
                <td>
                  <%= new Date(hist.date).toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "short",
                    day: "numeric"
                  }) %>
                </td>
                <td><%= hist.description %></td>
                <td class="transaction-amount">₹<%= hist.amount.toFixed(2) %></td>
                <td>
                  <span class="transaction-badge <%= hist.transaction_type === 'Cancelled' ? 'badge-credit' : 'badge-debit' %>">
                    <%= hist.transaction_type === 'Cancelled' ? 'Credit' : 'Debit' %>
                  </span>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="empty-state">
        <i class="icon-wallet"></i>
        <h3>No Transactions Yet</h3>
        <p style="color: #9ca3af;">Your transaction history will appear here</p>
      </div>
    <% } %>
  </div>
</div>

<!-- Scripts -->
<script>
  // Search functionality
  document.getElementById('searchInput')?.addEventListener('input', function(e) {
    const searchTerm = e.target.value.toLowerCase();
    const rows = document.querySelectorAll('#transactionsBody tr');
    
    rows.forEach(row => {
      const text = row.textContent.toLowerCase();
      row.style.display = text.includes(searchTerm) ? '' : 'none';
    });
  });
</script>

<%- include('../layouts/footer.ejs') %>
