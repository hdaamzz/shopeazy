<%- include('../layouts/header.ejs') %>

<style>
  .top-nav-bar {
    background: white;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    padding: 15px 0;
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  .top-nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .nav-logo img {
    height: 35px;
  }

  body {
    background: #f5f5f7;
  }

  .otp-container {
    min-height: calc(100vh - 70px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
  }

  .otp-card {
    background: #ffffff;
    border-radius: 16px;
    padding: 40px 32px;
    max-width: 500px;
    width: 100%;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
    border: 1px solid #e5e7eb;
  }

  .otp-icon {
    text-align: center;
    margin-bottom: 24px;
  }

  .otp-icon i {
    font-size: 52px;
    color: #4b5563;
  }

  .otp-title {
    text-align: center;
    font-size: 24px;
    font-weight: 700;
    color: #111827;
    margin-bottom: 10px;
  }

  .otp-description {
    text-align: center;
    color: #6b7280;
    margin-bottom: 28px;
    line-height: 1.5;
    font-size: 14px;
  }

  .otp-label {
    display: block;
    font-weight: 600;
    color: #374151;
    margin-bottom: 12px;
    font-size: 13px;
  }

  .otp-inputs {
    display: flex;
    gap: 10px;
    justify-content: center;
    margin-bottom: 25px;
  }

  .otp-input {
    width: 50px;
    height: 55px;
    text-align: center;
    font-size: 20px;
    font-weight: 600;
    border: 2px solid #d1d5db;
    border-radius: 10px;
    background: #f9fafb;
    transition: all 0.2s ease;
    outline: none;
  }

  .otp-input:focus {
    border-color: #4f46e5;
    background: #ffffff;
    box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.12);
  }

  .otp-input.filled {
    border-color: #10b981;
    background: #ecfdf5;
  }

  .error-message {
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #dc2626;
    padding: 12px;
    border-radius: 8px;
    margin-bottom: 20px;
    text-align: center;
    font-size: 14px;
    font-weight: 500;
  }

  .btn-submit {
    width: 100%;
    padding: 12px;
    background: #111827;
    color: #ffffff;
    border: none;
    border-radius: 999px;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.2s ease;
    margin-top: 10px;
  }

  .btn-submit:hover {
    background: #030712;
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.22);
    transform: translateY(-1px);
  }

  .btn-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .resend-section {
    text-align: center;
    margin-top: 25px;
    padding-top: 25px;
    border-top: 1px solid #e5e7eb;
  }

  .resend-text {
    color: #6b7280;
    font-size: 14px;
    margin-bottom: 10px;
  }

  .timer-display {
    color: #4b5563;
    font-weight: 600;
    font-size: 14px;
    margin-bottom: 10px;
  }

  .btn-resend {
    background: none;
    border: none;
    color: #4b5563;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    text-decoration: underline;
    padding: 0;
  }

  .btn-resend:hover:not(:disabled) {
    color: #111827;
  }

  .btn-resend:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .nav-logo img {
      height: 28px;
    }

    .otp-card {
      padding: 32px 22px;
    }

    .otp-inputs {
      gap: 8px;
    }

    .otp-input {
      width: 45px;
      height: 50px;
      font-size: 18px;
    }
  }
</style>

<!-- Top Navigation Bar -->
<nav class="top-nav-bar">
  <div class="top-nav-container">
    <a href="/" class="nav-logo">
      <img src="/assets/newimages/logo.png" alt="shopEazy Logo">
    </a>
  </div>
</nav>

<!-- OTP Verification -->
<div class="otp-container">
  <div class="otp-card">
    <div class="otp-icon">
      <i class="icon-envelope"></i>
    </div>

    <h1 class="otp-title">OTP Verification</h1>
    <p class="otp-description">
      Enter the 6-digit verification code sent to your email address.
    </p>

    <form id="otp-form" action="/auth/register/otp" method="POST">
      <label class="otp-label">Enter 6-digit code</label>
      
      <div class="otp-inputs">
        <input type="text" class="otp-input" maxlength="1" pattern="[0-9]" inputmode="numeric" autocomplete="off">
        <input type="text" class="otp-input" maxlength="1" pattern="[0-9]" inputmode="numeric" autocomplete="off">
        <input type="text" class="otp-input" maxlength="1" pattern="[0-9]" inputmode="numeric" autocomplete="off">
        <input type="text" class="otp-input" maxlength="1" pattern="[0-9]" inputmode="numeric" autocomplete="off">
        <input type="text" class="otp-input" maxlength="1" pattern="[0-9]" inputmode="numeric" autocomplete="off">
        <input type="text" class="otp-input" maxlength="1" pattern="[0-9]" inputmode="numeric" autocomplete="off">
      </div>

      <input type="hidden" id="otp" name="otp">
      <input type="hidden" id="email" name="email" value="<%= email %>">

      <% if (typeof message !== "undefined" && message) { %>
        <div class="error-message">
          <%= message %>
        </div>
      <% } %>

      <button type="submit" class="btn-submit">Verify OTP</button>
    </form>

    <div class="resend-section">
      <p class="resend-text">Didn't receive the code?</p>
      <div class="timer-display" id="timerDisplay">Resend OTP in 60s</div>
      <form action="/auth/register/otp/resend" method="POST" style="display: inline;">
        <input type="hidden" name="email" value="<%= email %>">
        <button type="submit" id="resendBtn" class="btn-resend" disabled>
          Resend OTP
        </button>
      </form>
    </div>
  </div>
</div>

<!-- Scripts -->
<script>
  document.addEventListener("DOMContentLoaded", function() {
    const inputs = document.querySelectorAll('.otp-input');
    const hiddenOtpInput = document.getElementById('otp');
    const resendBtn = document.getElementById('resendBtn');
    const timerDisplay = document.getElementById('timerDisplay');
    
    let timer = 60;
    let startTime = localStorage.getItem('otpStartTime');

    // Calculate remaining time
    if (startTime) {
      const elapsedSeconds = Math.floor((Date.now() - parseInt(startTime)) / 1000);
      timer = Math.max(60 - elapsedSeconds, 0);
    } else {
      localStorage.setItem('otpStartTime', Date.now().toString());
    }

    resendBtn.disabled = timer > 0;

    // Countdown timer
    const countdown = setInterval(() => {
      if (timer > 0) {
        timer--;
        timerDisplay.textContent = `Resend OTP in ${timer}s`;
      } else {
        clearInterval(countdown);
        resendBtn.disabled = false;
        timerDisplay.textContent = 'You can now resend the OTP';
        localStorage.removeItem('otpStartTime');
      }
    }, 1000);

    // OTP Input handling
    inputs.forEach((input, index) => {
      // Focus next input on entry
      input.addEventListener('input', function(e) {
        const value = this.value;
        
        // Only allow numbers
        if (!/^\d*$/.test(value)) {
          this.value = '';
          return;
        }

        // Add filled class
        if (value) {
          this.classList.add('filled');
        } else {
          this.classList.remove('filled');
        }

        // Move to next input
        if (value.length === 1 && index < inputs.length - 1) {
          inputs[index + 1].focus();
        }

        updateHiddenInput();
      });

      // Handle backspace
      input.addEventListener('keydown', function(e) {
        if (e.key === 'Backspace' && !this.value && index > 0) {
          inputs[index - 1].focus();
          inputs[index - 1].value = '';
          inputs[index - 1].classList.remove('filled');
          updateHiddenInput();
        }
      });

      // Handle paste
      input.addEventListener('paste', function(e) {
        e.preventDefault();
        const pastedData = e.clipboardData.getData('text').slice(0, 6);
        
        if (/^\d+$/.test(pastedData)) {
          pastedData.split('').forEach((char, i) => {
            if (inputs[i]) {
              inputs[i].value = char;
              inputs[i].classList.add('filled');
            }
          });
          updateHiddenInput();
          
          // Focus last filled input
          const lastIndex = Math.min(pastedData.length, inputs.length) - 1;
          inputs[lastIndex].focus();
        }
      });
    });

    // Update hidden input with combined OTP
    function updateHiddenInput() {
      let otpValue = '';
      inputs.forEach(input => {
        otpValue += input.value;
      });
      hiddenOtpInput.value = otpValue;
    }

    // Auto-focus first input
    inputs[0].focus();

    // Clear timer on resend
    resendBtn.parentElement.addEventListener('submit', function() {
      localStorage.removeItem('otpStartTime');
      clearInterval(countdown);
    });
  });
</script>

<%- include('../layouts/footer.ejs') %>
