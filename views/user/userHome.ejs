<%- include('../layouts/header.ejs') %>

<style>
  /* Top Navigation */
  .top-nav-bar {
    background: white;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    padding: 15px 0;
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  .top-nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .nav-logo img {
    height: 35px;
  }

  .nav-center {
    flex: 1;
    max-width: 600px;
    margin: 0 40px;
  }

  .search-form {
    position: relative;
  }

  .search-input {
    width: 100%;
    padding: 12px 50px 12px 20px;
    border: 2px solid #e5e7eb;
    border-radius: 999px;
    font-size: 14px;
    transition: all 0.2s ease;
  }

  .search-input:focus {
    outline: none;
    border-color: #111827;
  }

  .search-btn {
    position: absolute;
    right: 5px;
    top: 50%;
    transform: translateY(-50%);
    background: #111827;
    color: white;
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
  }

  .nav-icons {
    display: flex;
    gap: 30px;
    align-items: center;
  }

  .nav-icon-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: #333;
    transition: all 0.3s ease;
    position: relative;
  }

  .nav-icon-item:hover {
    color: #111827;
    transform: translateY(-2px);
  }

  .nav-icon-wrapper {
    position: relative;
    font-size: 24px;
  }

  .cart-count {
    position: absolute;
    top: -8px;
    right: -8px;
    background: #dc2626;
    color: white;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    font-size: 11px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .nav-icon-label {
    font-size: 12px;
    margin-top: 4px;
    font-weight: 500;
  }

  .user-menu {
    position: relative;
  }

  .user-btn {
    background: #f3f4f6;
    border: none;
    padding: 8px 16px;
    border-radius: 999px;
    cursor: pointer;
    font-weight: 600;
    font-size: 14px;
  }

  .user-btn:hover {
    background: #e5e7eb;
  }

  body {
    background: #f5f5f7;
  }

  /* Hero Section */
  .hero-section {
    background: linear-gradient(135deg, #ffffff 0%, #9197af 100%);
    padding: 80px 20px;
    text-align: center;
    color: white;
  }

  .hero-content h1 {
    font-size: 48px;
    font-weight: 700;
    margin-bottom: 20px;
  }

  .hero-content p {
    font-size: 20px;
    opacity: 0.9;
    margin-bottom: 30px;
  }

  .btn-hero {
    display: inline-block;
    padding: 15px 40px;
    background: white;
    color: #000000;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
    font-size: 16px;
    transition: all 0.3s ease;
  }

  .btn-hero:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    color: #000000;
  }

  /* Categories */
  .categories-section {
    max-width: 1400px;
    margin: 50px auto;
    padding: 0 20px;
  }

  .section-title {
    font-size: 28px;
    font-weight: 700;
    color: #111827;
    margin-bottom: 30px;
  }

  .categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 20px;
    margin-bottom: 50px;
  }

  .category-card {
    background: white;
    padding: 30px 20px;
    border-radius: 12px;
    text-align: center;
    text-decoration: none;
    color: #111827;
    border: 1px solid #e5e7eb;
    transition: all 0.3s ease;
  }

  .category-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    color: #111827;
  }

  .category-card i {
    font-size: 36px;
    color: #000000;
    margin-bottom: 15px;
  }

  .category-name {
    font-weight: 600;
    font-size: 14px;
  }

  /* Products Section */
  .products-section {
    max-width: 1400px;
    margin: 0 auto 50px;
    padding: 0 20px;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
  }

  .view-all-link {
    color: #000000;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .view-all-link:hover {
    color: #000000;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 20px;
  }

  .product-card {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.3s ease;
    border: 1px solid #e5e7eb;
    position: relative;
  }

  .product-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }

  .product-image-wrapper {
    position: relative;
    overflow: hidden;
    padding-top: 100%;
  }

  .product-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .discount-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    background: #dc2626;
    color: white;
    padding: 6px 12px;
    border-radius: 20px;
    font-weight: 700;
    font-size: 12px;
    z-index: 10;
  }

  .wishlist-btn {
    position: absolute;
    top: 10px;
    left: 10px;
    background: white;
    border: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    z-index: 10;
  }

  .wishlist-btn:hover {
    background: #111827;
    color: white;
  }

  .product-actions {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
    padding: 20px 15px 15px;
    transform: translateY(100%);
    transition: transform 0.3s ease;
  }

  .product-card:hover .product-actions {
    transform: translateY(0);
  }

  .btn-add-cart {
    width: 100%;
    padding: 10px;
    background: white;
    color: #111827;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    font-size: 13px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-add-cart:hover {
    background: #111827;
    color: white;
  }

  .product-info {
    padding: 15px;
  }

  .product-name {
    font-size: 15px;
    font-weight: 600;
    color: #111827;
    margin-bottom: 8px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-name a {
    text-decoration: none;
    color: inherit;
  }

  .product-name a:hover {
    color: #667eea;
  }

  .product-price {
    font-size: 18px;
    font-weight: 700;
    color: #111827;
  }

  .old-price {
    font-size: 14px;
    color: #9ca3af;
    text-decoration: line-through;
    margin-left: 8px;
  }

  /* Features Section */
  .features-section {
    background: white;
    padding: 60px 20px;
    margin: 50px 0;
  }

  .features-container {
    max-width: 1400px;
    margin: 0 auto;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 40px;
  }

  .feature-box {
    text-align: center;
  }

  .feature-icon {
    width: 60px;
    height: 60px;
    background: #f3f4f6;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
    font-size: 24px;
    color: #667eea;
  }

  .feature-title {
    font-size: 18px;
    font-weight: 700;
    color: #111827;
    margin-bottom: 10px;
  }

  .feature-desc {
    color: #6b7280;
    font-size: 14px;
  }

  /* Newsletter */
  .newsletter-section {
    background: linear-gradient(135deg, #ffffff 0%, #9197af 100%);
    padding: 60px 20px;
    text-align: center;
    color: white;
  }

  .newsletter-container {
    max-width: 600px;
    margin: 0 auto;
  }

  .newsletter-title {
    font-size: 32px;
    font-weight: 700;
    margin-bottom: 10px;
  }

  .newsletter-desc {
    opacity: 0.9;
    margin-bottom: 30px;
  }

  .newsletter-form {
    display: flex;
    gap: 10px;
  }

  .newsletter-input {
    flex: 1;
    padding: 15px 20px;
    border: none;
    border-radius: 999px;
    font-size: 14px;
  }

  .newsletter-btn {
    padding: 15px 30px;
    background: #111827;
    color: white;
    border: none;
    border-radius: 999px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .newsletter-btn:hover {
    background: #030712;
  }

  /* Footer */
  .footer {
    background: white;
    border-top: 1px solid #e5e7eb;
    padding: 60px 20px 30px;
  }

  .footer-container {
    max-width: 1400px;
    margin: 0 auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 40px;
    margin-bottom: 40px;
  }

  .footer-col h4 {
    font-size: 16px;
    font-weight: 700;
    color: #111827;
    margin-bottom: 20px;
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
  }

  .footer-col ul li {
    margin-bottom: 12px;
  }

  .footer-col ul li a {
    color: #6b7280;
    text-decoration: none;
    font-size: 14px;
  }

  .footer-col ul li a:hover {
    color: #111827;
  }

  .footer-bottom {
    text-align: center;
    padding-top: 30px;
    border-top: 1px solid #e5e7eb;
    color: #6b7280;
    font-size: 14px;
  }

  /* Auth Modal */
  .modal-content {
    border-radius: 12px;
    border: none;
  }

  .form-tab .nav-pills {
    background: #f3f4f6;
    border-radius: 999px;
    padding: 4px;
  }

  .form-tab .nav-link {
    border-radius: 999px;
    font-weight: 600;
  }

  .form-tab .nav-link.active {
    background: #111827;
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .nav-logo img {
      height: 28px;
    }

    .nav-center {
      display: none;
    }

    .nav-icon-label {
      display: none;
    }

    .hero-content h1 {
      font-size: 32px;
    }

    .hero-content p {
      font-size: 16px;
    }

    .categories-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .products-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
    }

    .newsletter-form {
      flex-direction: column;
    }

    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<!-- Top Navigation -->
<nav class="top-nav-bar">
  <div class="top-nav-container">
    <a href="/" class="nav-logo">
      <img src="assets/newimages/logo.png" alt="shopEazy Logo">
    </a>

    <div class="nav-center">
      <form action="/search-results" method="GET" class="search-form">
        <input type="text" name="q" class="search-input" placeholder="Search products..." required>
        <button type="submit" class="search-btn">
          <i class="icon-search"></i>
        </button>
      </form>
    </div>

    <div class="nav-icons">
      <a href="/wallet" class="nav-icon-item">
        <div class="nav-icon-wrapper">
          <i class="fa-solid fa-wallet"></i>
        </div>
        <span class="nav-icon-label">Wallet</span>
      </a>

      <a href="/wishlist" class="nav-icon-item">
        <div class="nav-icon-wrapper">
          <i class="icon-heart-o"></i>
        </div>
        <span class="nav-icon-label">Wishlist</span>
      </a>

      <a href="<%= cartItems ? '/cart' : '/nonUserCart' %>" class="nav-icon-item">
        <div class="nav-icon-wrapper">
          <i class="icon-shopping-cart"></i>
          <% if (cartItems && cartItems.length > 0) { %>
            <span class="cart-count"><%= cartItems.length %></span>
          <% } %>
        </div>
        <span class="nav-icon-label">Cart</span>
      </a>

      <div class="user-menu">
        <% if (!userData) { %>
          <button class="user-btn" data-toggle="modal" data-target="#signin-modal">
            Sign In
          </button>
        <% } else { %>
          <a href="/dashboard" class="nav-icon-item">
            <div class="nav-icon-wrapper">
              <i class="icon-user"></i>
            </div>
            <span class="nav-icon-label"><%= userData.user_name %></span>
          </a>
        <% } %>
      </div>
    </div>
  </div>
</nav>

<!-- Hero Section -->
<section class="hero-section">
  <div class="hero-content">
    <h1>Welcome to shopEazy</h1>
    <p>Discover amazing products at unbeatable prices</p>
    <a href="/shop" class="btn-hero">Shop Now</a>
  </div>
</section>

<!-- Categories Section -->
<section class="categories-section">
  <h2 class="section-title">Shop by Category</h2>
  <div class="categories-grid">
    <% (category || []).forEach(c => { %>
      <a href="/productCategories?id=<%= c._id %>" class="category-card">
        <i class="icon-tag"></i>
        <div class="category-name"><%= c.category_name %></div>
      </a>
    <% }); %>
  </div>
</section>

<!-- New Arrivals Section -->
<section class="products-section">
  <div class="section-header">
    <h2 class="section-title">New Arrivals</h2>
    <a href="/shop" class="view-all-link">
      View All <i class="icon-long-arrow-right"></i>
    </a>
  </div>

  <div class="products-grid">
    <% (product || []).slice(0, 12).forEach(p => {
      let bestDiscount = 0;
      let hasDiscount = false;
      let discountedPrice = p.price;

      (offers || []).forEach(item => {
        if (item.type === 'PRODUCT') {
          (item.products || []).forEach(Product => {
            if (String(p._id) === String(Product._id) && item.discount > bestDiscount) {
              bestDiscount = item.discount;
              hasDiscount = true;
              discountedPrice = p.price * (1 - bestDiscount / 100);
            }
          });
        }
      });

      (offers || []).forEach(item => {
        if (item.type === 'CATEGORY') {
          const categoryMatch = (item.category || []).some(cat => String(p.category) === String(cat));
          if (categoryMatch && item.discount > bestDiscount) {
            bestDiscount = item.discount;
            hasDiscount = true;
            discountedPrice = p.price * (1 - bestDiscount / 100);
          }
        }
      });
    %>
      <div class="product-card">
        <div class="product-image-wrapper">
          <a href="/showProduct?id=<%= p._id %>">
            <img src="/uploads/<%= p.images[0] %>" alt="<%= p.product_name %>" class="product-image">
          </a>

          <% if (hasDiscount) { %>
            <div class="discount-badge"><%= bestDiscount %>% OFF</div>
          <% } %>

          <% if (userData) { %>
            <button class="wishlist-btn btn-wishlist" data-product-id="<%= p._id %>" data-user-id="<%= userData._id %>">
              <i class="icon-heart-o"></i>
            </button>
          <% } %>

          <div class="product-actions">
            <% if (p.stock === 0) { %>
              <button class="btn-add-cart" disabled>Out of Stock</button>
            <% } else if (!userData) { %>
              <button class="btn-add-cart" data-toggle="modal" data-target="#signin-modal">Login to Buy</button>
            <% } else { %>
              <button class="btn-add-cart btn-add-to-cart" data-product-id="<%= p._id %>" data-user-id="<%= userData._id %>">
                Add to Cart
              </button>
            <% } %>
          </div>
        </div>

        <div class="product-info">
          <h3 class="product-name">
            <a href="/showProduct?id=<%= p._id %>"><%= p.product_name %></a>
          </h3>
          <div class="product-price">
            <% if (hasDiscount) { %>
              ₹<%= discountedPrice.toFixed(2) %>
              <span class="old-price">₹<%= p.price.toFixed(2) %></span>
            <% } else { %>
              ₹<%= p.price.toFixed(2) %>
            <% } %>
          </div>
        </div>
      </div>
    <% }); %>
  </div>
</section>

<!-- Features Section -->
<section class="features-section">
  <div class="features-container">
    <div class="features-grid">
      <div class="feature-box">
        <div class="feature-icon">
