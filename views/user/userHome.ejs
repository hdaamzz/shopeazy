<!-- Auth Modal -->
<div class="modal fade" id="signin-modal" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content" style="border-radius: 16px; overflow: hidden; border: none;">
      
      <!-- Modal Header -->
      <div class="modal-header" style="border: none; padding: 20px 30px 0;">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="font-size: 28px; opacity: 0.5;">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>

      <!-- Modal Body -->
      <div class="modal-body" style="padding: 0 30px 30px;">
        
        <!-- Tab Navigation -->
        <div class="auth-tabs" style="margin-bottom: 30px;">
          <ul class="nav nav-pills nav-fill" role="tablist" style="background: #f3f4f6; border-radius: 50px; padding: 4px;">
            <li class="nav-item">
