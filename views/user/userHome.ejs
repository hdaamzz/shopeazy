<!-- Scripts -->
<script src="assets/js/jquery.min.js"></script>
<script src="assets/js/bootstrap.bundle.min.js"></script>
<script src="assets/js/owl.carousel.min.js"></script>
<script src="assets/js/main.js"></script>

<script>
  // Wishlist functionality
  document.querySelectorAll('.btn-wishlist').forEach(button => {
    button.addEventListener('click', async function() {
      const productId = this.getAttribute('data-product-id');
      const userId = this.getAttribute('data-user-id');

      try {
        const res = await fetch('/addWishlistItem', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ productId, userId })
        });
        const data = await res.json();

        if (data.success) {
          Swal.fire({
            icon: 'success',
            title: 'Added to Wishlist!',
            confirmButtonColor: '#111827',
            timer: 2000
          });
        } else {
          Swal.fire({
            icon: 'info',
            text: data.message,
            confirmButtonColor: '#111827'
          });
        }
      } catch (error) {
        console.error('Error:', error);
      }
    });
  });

  // Add to cart functionality
  document.querySelectorAll('.btn-add-to-cart').forEach(button => {
    button.addEventListener('click', async function() {
      const productId = this.getAttribute('data-product-id');
      const userId = this.getAttribute('data-user-id');

      try {
        const res = await fetch('/addCartItem', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ productId, quantity: 1, userId })
        });
        const data = await res.json();

        if (data.success) {
          Swal.fire({
            icon: 'success',
            title: 'Added to Cart!',
            confirmButtonColor: '#111827',
            timer: 2000
          }).then(() => {
            location.reload(); // Reload to update cart count
          });
        } else {
          Swal.fire({
            icon: 'info',
            text: data.message,
            confirmButtonColor: '#111827'
          });
        }
      } catch (error) {
        console.error('Error:', error);
      }
    });
  });

  // ========== LOGIN FORM ==========
  const loginForm = document.getElementById('login-form');
  const loginEmail = document.getElementById('singin-email');
  const loginPassword = document.getElementById('singin-password');
  const loginError = document.querySelector('.main-error');

  // Clear error on input
  [loginEmail, loginPassword].forEach(input => {
    input.addEventListener('input', () => {
      loginError.innerText = '';
      input.classList.remove('error');
    });
  });

  loginForm.addEventListener('submit', async function(event) {
    event.preventDefault();
    
    const emailVal = loginEmail.value.trim();
    const passVal = loginPassword.value.trim();

    // Reset errors
    loginError.innerText = '';
    loginEmail.classList.remove('error');
    loginPassword.classList.remove('error');

    // Validation
    if (!emailVal) {
      loginEmail.classList.add('error');
      loginError.innerText = 'Email is required';
      return;
    }

    if (!passVal) {
      loginPassword.classList.add('error');
      loginError.innerText = 'Password is required';
      return;
    }

    // Email format validation
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(emailVal)) {
      loginEmail.classList.add('error');
      loginError.innerText = 'Please enter a valid email address';
      return;
    }

    // Disable button during submission
    const submitBtn = loginForm.querySelector('button[type="submit"]');
    const originalText = submitBtn.innerText;
    submitBtn.disabled = true;
    submitBtn.innerText = 'Signing in...';

    try {
      const response = await fetch('/signin', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: emailVal, password: passVal })
      });

      const message = await response.json();

      if (message.success) {
        Swal.fire({
          icon: 'success',
          title: 'Welcome Back!',
          text: 'Login successful',
          confirmButtonColor: '#111827',
          timer: 1500,
          showConfirmButton: false
        }).then(() => {
          window.location.href = '/home';
        });
      } else {
        loginEmail.classList.add('error');
        loginPassword.classList.add('error');
        loginError.innerText = message.msg || 'Invalid email or password';
        submitBtn.disabled = false;
        submitBtn.innerText = originalText;
      }
    } catch (error) {
      console.error('Error:', error);
      loginError.innerText = 'An error occurred. Please try again.';
      submitBtn.disabled = false;
      submitBtn.innerText = originalText;
    }
  });

  // ========== SIGNUP FORM ==========
  const signupForm = document.getElementById('signup-form');
  const signupName = document.getElementById('register-name');
  const signupEmail = document.getElementById('register-email');
  const signupPass = document.getElementById('register-password0');
  const signupConfirmPass = document.getElementById('register-password');
  const signupError = document.querySelector('.main-error1');

  // Clear error on input
  [signupName, signupEmail, signupPass, signupConfirmPass].forEach(input => {
    input.addEventListener('input', () => {
      signupError.innerText = '';
      input.classList.remove('error');
    });
  });

  signupForm.addEventListener('submit', async function(event) {
    event.preventDefault();
    
    const nameValue = signupName.value.trim();
    const emailValue = signupEmail.value.trim();
    const passValue = signupPass.value.trim();
    const confirmPassValue = signupConfirmPass.value.trim();

    // Reset errors
    signupError.innerText = '';
    [signupName, signupEmail, signupPass, signupConfirmPass].forEach(input => {
      input.classList.remove('error');
    });

    // Validation
    if (!nameValue) {
      signupName.classList.add('error');
      signupError.innerText = 'Name is required';
      return;
    }

    if (nameValue.length < 3) {
      signupName.classList.add('error');
      signupError.innerText = 'Name must be at least 3 characters';
      return;
    }

    if (!emailValue) {
      signupEmail.classList.add('error');
      signupError.innerText = 'Email is required';
      return;
    }

    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(emailValue)) {
      signupEmail.classList.add('error');
      signupError.innerText = 'Please enter a valid email address';
      return;
    }

    if (!passValue) {
      signupPass.classList.add('error');
      signupError.innerText = 'Password is required';
      return;
    }

    if (passValue.length < 8) {
      signupPass.classList.add('error');
      signupError.innerText = 'Password must be at least 8 characters';
      return;
    }

    if (!confirmPassValue) {
      signupConfirmPass.classList.add('error');
      signupError.innerText = 'Please confirm your password';
      return;
    }

    if (passValue !== confirmPassValue) {
      signupPass.classList.add('error');
      signupConfirmPass.classList.add('error');
      signupError.innerText = 'Passwords do not match';
      return;
    }

    // Disable button during submission
    const submitBtn = signupForm.querySelector('button[type="submit"]');
    const originalText = submitBtn.innerText;
    submitBtn.disabled = true;
    submitBtn.innerText = 'Creating Account...';

    try {
      const response = await fetch('/signup', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ 
          email: emailValue, 
          password: confirmPassValue, 
          name: nameValue 
        })
      });

      const message = await response.json();

      if (message.success) {
        Swal.fire({
          icon: 'success',
          title: 'Account Created!',
          text: 'Please verify your email',
          confirmButtonColor: '#111827',
          timer: 1500,
          showConfirmButton: false
        }).then(() => {
          window.location.href = message.redirectUrl || '/otpValidate';
        });
      } else {
        signupError.innerText = message.message || 'An error occurred during registration';
        submitBtn.disabled = false;
        submitBtn.innerText = originalText;
      }
    } catch (error) {
      console.error('Error:', error);
      signupError.innerText = 'An error occurred. Please try again.';
      submitBtn.disabled = false;
      submitBtn.innerText = originalText;
    }
  });

  // Reset forms when modal is closed
  $('#signin-modal').on('hidden.bs.modal', function () {
    loginForm.reset();
    signupForm.reset();
    document.querySelectorAll('.main-error, .main-error1').forEach(el => el.innerText = '');
    document.querySelectorAll('.auth-input').forEach(input => input.classList.remove('error'));
  });
</script>


