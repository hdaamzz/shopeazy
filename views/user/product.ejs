<%- include('../layouts/header.ejs') %>

<style>
  .top-nav-bar {
    background: white;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    padding: 15px 0;
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  .top-nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .nav-logo img {
    height: 35px;
  }

  .nav-icons {
    display: flex;
    gap: 30px;
    align-items: center;
  }

  .nav-icon-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: #333;
    transition: all 0.3s ease;
  }

  .nav-icon-item:hover {
    color: #111827;
    transform: translateY(-2px);
  }

  .nav-icon-wrapper {
    position: relative;
    font-size: 24px;
  }

  .nav-icon-label {
    font-size: 12px;
    margin-top: 4px;
    font-weight: 500;
  }

  body {
    background: #f5f5f7;
  }

  .breadcrumb-nav {
    background: white;
    padding: 15px 0;
    border-bottom: 1px solid #e5e7eb;
  }

  .breadcrumb {
    margin: 0;
  }

  .product-container {
    max-width: 1200px;
    margin: 30px auto;
    padding: 0 20px;
  }

  .product-card {
    background: white;
    border-radius: 12px;
    padding: 40px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    border: 1px solid #e5e7eb;
  }

  .product-gallery {
    position: relative;
  }

  .discount-badge {
    position: absolute;
    top: 15px;
    right: 15px;
    background: #dc2626;
    color: white;
    padding: 8px 16px;
    border-radius: 20px;
    font-weight: 700;
    font-size: 14px;
    z-index: 10;
  }

  .main-image {
    width: 100%;
    border-radius: 12px;
    border: 1px solid #e5e7eb;
    margin-bottom: 15px;
  }

  .thumbnail-gallery {
    display: flex;
    gap: 10px;
  }

  .thumbnail {
    width: 80px;
    height: 80px;
    border-radius: 8px;
    border: 2px solid #e5e7eb;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .thumbnail:hover,
  .thumbnail.active {
    border-color: #111827;
  }

  .product-title {
    font-size: 28px;
    font-weight: 700;
    color: #111827;
    margin-bottom: 15px;
  }

  .product-price {
    font-size: 32px;
    font-weight: 700;
    color: #111827;
    margin: 20px 0;
  }

  .old-price {
    font-size: 24px;
    color: #9ca3af;
    text-decoration: line-through;
    margin-left: 10px;
  }

  .product-description {
    color: #6b7280;
    line-height: 1.6;
    margin: 20px 0;
  }

  .stock-warning {
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #dc2626;
    padding: 12px;
    border-radius: 8px;
    margin: 20px 0;
    font-weight: 600;
  }

  .stock-warning.out-of-stock {
    background: #fee2e2;
  }

  .quantity-selector {
    display: flex;
    align-items: center;
    gap: 15px;
    margin: 25px 0;
  }

  .quantity-input {
    width: 80px;
    padding: 10px;
    text-align: center;
    border: 2px solid #d1d5db;
    border-radius: 8px;
    font-weight: 600;
  }

  .btn-add-cart {
    flex: 1;
    padding: 14px 30px;
    background: #111827;
    color: white;
    border: none;
    border-radius: 999px;
    font-weight: 600;
    font-size: 15px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-add-cart:hover {
    background: #030712;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
  }

  .btn-wishlist {
    padding: 14px 24px;
    background: white;
    border: 2px solid #e5e7eb;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-wishlist:hover {
    border-color: #111827;
  }

  .product-meta {
    margin-top: 25px;
    padding-top: 25px;
    border-top: 1px solid #e5e7eb;
    color: #6b7280;
  }

  @media (max-width: 768px) {
    .nav-logo img {
      height: 28px;
    }

    .nav-icon-label {
      display: none;
    }

    .product-card {
      padding: 20px;
    }

    .product-title {
      font-size: 22px;
    }

    .product-price {
      font-size: 26px;
    }
  }
</style>

<!-- Top Navigation -->
<nav class="top-nav-bar">
  <div class="top-nav-container">
    <a href="/" class="nav-logo">
      <img src="assets/newimages/logo.png" alt="shopEazy Logo">
    </a>

    <div class="nav-icons">
      <a href="/wallet" class="nav-icon-item">
        <div class="nav-icon-wrapper">
          <i class="fa-solid fa-wallet"></i>
        </div>
        <span class="nav-icon-label">Wallet</span>
      </a>

      <a href="/wishlist" class="nav-icon-item">
        <div class="nav-icon-wrapper">
          <i class="icon-heart-o"></i>
        </div>
        <span class="nav-icon-label">Wishlist</span>
      </a>

      <a href="/cart" class="nav-icon-item">
        <div class="nav-icon-wrapper">
          <i class="icon-shopping-cart"></i>
        </div>
        <span class="nav-icon-label">Cart</span>
      </a>
    </div>
  </div>
</nav>

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="breadcrumb-nav">
  <div class="container">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/">Home</a></li>
      <li class="breadcrumb-item"><a href="/shop">Products</a></li>
      <li class="breadcrumb-item active"><%= productData.product_name %></li>
    </ol>
  </div>
</nav>

<!-- Product Details -->
<div class="product-container">
  <div class="product-card">
    <div class="row">
      <!-- Product Gallery -->
      <div class="col-md-6">
        <div class="product-gallery">
          <% 
            let bestDiscount = 0;
            let hasDiscount = false;
            let discountedPrice = productData.price;
            
            // Check product offers
            offers.forEach((item) => {
              if (item.type === 'PRODUCT') {
                item.products.forEach((Product) => {
                  if (String(productData._id) === String(Product._id)) {
                    if (item.discount > bestDiscount) {
                      bestDiscount = item.discount;
                      hasDiscount = true;
                      discountedPrice = productData.price * (1 - bestDiscount / 100);
                    }
                  }
                });
              }
            });
            
            // Check category offers
            offers.forEach((item) => {
              if (item.type === 'CATEGORY') {
                const categoryMatch = item.category.some(category => 
                  String(productData.category) === String(category)
                );
                if (categoryMatch && item.discount > bestDiscount) {
                  bestDiscount = item.discount;
                  hasDiscount = true;
                  discountedPrice = productData.price * (1 - bestDiscount / 100);
                }
              }
            });
          %>
          
          <% if (hasDiscount) { %>
            <div class="discount-badge"><%= bestDiscount %>% OFF</div>
          <% } %>
          
          <img id="mainImage" src="/uploads/<%= productData.images[0] %>" alt="<%= productData.product_name %>" class="main-image">
          
          <div class="thumbnail-gallery">
            <% productData.images.forEach((image, index) => { %>
              <img src="/uploads/<%= image %>" alt="Product view <%= index + 1 %>" 
                   class="thumbnail <%= index === 0 ? 'active' : '' %>" 
                   onclick="changeImage(this, '/uploads/<%= image %>')">
            <% }); %>
          </div>
        </div>
      </div>

      <!-- Product Info -->
      <div class="col-md-6">
        <h1 class="product-title"><%= productData.product_name %></h1>
        
        <div class="product-price">
          <% if (hasDiscount) { %>
            ₹<%= discountedPrice.toFixed(2) %>
            <span class="old-price">₹<%= productData.price.toFixed(2) %></span>
          <% } else { %>
            ₹<%= productData.price.toFixed(2) %>
          <% } %>
        </div>

        <p class="product-description"><%= productData.description %></p>

        <% if (productData.stock === 0) { %>
          <div class="stock-warning out-of-stock">
            Out of Stock
          </div>
        <% } else if (productData.stock < 5) { %>
          <div class="stock-warning">
            Only <%= productData.stock %> items left in stock!
          </div>
        <% } %>

        <% if (productData.stock > 0) { %>
          <div class="quantity-selector">
            <input type="number" id="qty" class="quantity-input" 
                   value="1" min="1" 
                   max="<%= productData.stock > 5 ? 5 : productData.stock %>">
            
            <% if (typeof userData !== 'undefined') { %>
              <button class="btn-add-cart" data-product-id="<%= productData._id %>" data-user-id="<%= userData._id %>">
                <i class="icon-shopping-cart"></i> Add to Cart
              </button>
              <button class="btn-wishlist" data-product-id="<%= productData._id %>" data-user-id="<%= userData._id %>">
                <i class="icon-heart-o"></i>
              </button>
            <% } else { %>
              <a href="/login" class="btn-add-cart" style="text-decoration: none; text-align: center;">
                Login to Purchase
              </a>
            <% } %>
          </div>
        <% } %>

        <div class="product-meta">
          <p><strong>Category:</strong> <a href="/productCategories?id=<%= productData.category._id %>"><%= productData.category.category_name %></a></p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Scripts -->
<script>
  // Change main image on thumbnail click
  function changeImage(thumb, src) {
    document.getElementById('mainImage').src = src;
    document.querySelectorAll('.thumbnail').forEach(t => t.classList.remove('active'));
    thumb.classList.add('active');
  }

  // Add to Cart
  document.querySelectorAll('.btn-add-cart').forEach(button => {
    button.addEventListener('click', async function() {
      const productId = this.getAttribute('data-product-id');
      const userId = this.getAttribute('data-user-id');
      const quantity = document.getElementById('qty').value;

      try {
        const response = await fetch('/addCartItem', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ productId, quantity, userId })
        });

        const data = await response.json();

        if (data.success) {
          Swal.fire({
            icon: 'success',
            title: 'Added to Cart!',
            text: 'Product has been added to your cart',
            confirmButtonColor: '#111827'
          });
        } else {
          Swal.fire({
            icon: 'info',
            title: 'Info',
            text: data.message,
            confirmButtonColor: '#111827'
          });
        }
      } catch (error) {
        console.error('Error:', error);
        Swal.fire({
          icon: 'error',
          title: 'Error',
          text: 'Failed to add item to cart',
          confirmButtonColor: '#111827'
        });
      }
    });
  });

  // Add to Wishlist
  document.querySelectorAll('.btn-wishlist').forEach(button => {
    button.addEventListener('click', async function() {
      const productId = this.getAttribute('data-product-id');
      const userId = this.getAttribute('data-user-id');

      try {
        const response = await fetch('/addWishlistItem', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ productId, userId })
        });

        const data = await response.json();

        if (data.success) {
          Swal.fire({
            icon: 'success',
            title: 'Added to Wishlist!',
            text: 'Product has been added to your wishlist',
            confirmButtonColor: '#111827'
          });
        } else {
          Swal.fire({
            icon: 'info',
            title: 'Info',
            text: data.message,
            confirmButtonColor: '#111827'
          });
        }
      } catch (error) {
        console.error('Error:', error);
        Swal.fire({
          icon: 'error',
          title: 'Error',
          text: 'Failed to add item to wishlist',
          confirmButtonColor: '#111827'
        });
      }
    });
  });
</script>

<%- include('../layouts/footer.ejs') %>
