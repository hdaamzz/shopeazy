<%- include('../layouts/header.ejs') %>

<style>
  .top-nav-bar {
    background: white;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    padding: 15px 0;
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  .top-nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .nav-logo img {
    height: 35px;
  }

  .nav-icons {
    display: flex;
    gap: 30px;
    align-items: center;
  }

  .nav-icon-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: #333;
    transition: all 0.3s ease;
    position: relative;
  }

  .nav-icon-item:hover {
    color: #667eea;
    transform: translateY(-2px);
  }

  .nav-icon-wrapper {
    position: relative;
    font-size: 24px;
  }

  .nav-icon-badge {
    position: absolute;
    top: -8px;
    right: -8px;
    background: #667eea;
    color: white;
    border-radius: 50%;
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 600;
  }

  .nav-icon-label {
    font-size: 12px;
    margin-top: 4px;
    font-weight: 500;
  }

  .empty-cart-container {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60px 20px;
  }

  .empty-cart-content {
    text-align: center;
    max-width: 500px;
  }

  .empty-cart-icon {
    font-size: 120px;
    color: #ddd;
    margin-bottom: 30px;
    animation: float 3s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  .empty-cart-title {
    font-size: 32px;
    font-weight: 700;
    color: #333;
    margin-bottom: 15px;
  }

  .empty-cart-description {
    font-size: 16px;
    color: #888;
    margin-bottom: 40px;
    line-height: 1.6;
  }

  .empty-cart-buttons {
    display: flex;
    gap: 15px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .empty-cart-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 15px 30px;
    border-radius: 50px;
    font-weight: 600;
    font-size: 14px;
    transition: all 0.3s ease;
    text-decoration: none;
  }

  .empty-cart-btn-primary {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
  }

  .empty-cart-btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(102, 126, 234, 0.6);
    color: white;
  }

  .empty-cart-btn-secondary {
    background: white;
    color: #667eea;
    border: 2px solid #667eea;
  }

  .empty-cart-btn-secondary:hover {
    background: #667eea;
    color: white;
    transform: translateY(-3px);
  }

  .popular-categories {
    background: #f8f9fa;
    padding: 60px 20px;
  }

  .popular-categories h2 {
    text-align: center;
    font-size: 28px;
    font-weight: 700;
    color: #333;
    margin-bottom: 40px;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .category-card {
    background: white;
    border-radius: 12px;
    padding: 30px 20px;
    text-align: center;
    transition: all 0.3s ease;
    text-decoration: none;
    color: #333;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .category-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.15);
    color: #667eea;
  }

  .category-icon {
    font-size: 48px;
    margin-bottom: 15px;
  }

  .category-name {
    font-size: 16px;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .nav-icons {
      gap: 20px;
    }

    .nav-icon-label {
      display: none;
    }

    .nav-logo img {
      height: 28px;
    }

    .empty-cart-icon {
      font-size: 80px;
    }

    .empty-cart-title {
      font-size: 24px;
    }

    .empty-cart-buttons {
      flex-direction: column;
    }

    .empty-cart-btn {
      width: 100%;
      justify-content: center;
    }

    .category-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<!-- Top Navigation Bar -->
<nav class="top-nav-bar">
  <div class="top-nav-container">
    <a href="/" class="nav-logo">
      <img src="assets/newimages/logo.png" alt="shopEazy Logo">
    </a>

    <div class="nav-icons">
      <a href="/wallet" class="nav-icon-item">
        <div class="nav-icon-wrapper">
          <i class="fa-solid fa-wallet"></i>
        </div>
        <span class="nav-icon-label">Wallet</span>
      </a>

      <a href="/wishlist" class="nav-icon-item">
        <div class="nav-icon-wrapper">
          <i class="icon-heart-o"></i>
        </div>
        <span class="nav-icon-label">Wishlist</span>
      </a>

      <a href="/cart" class="nav-icon-item">
        <div class="nav-icon-wrapper">
          <i class="icon-shopping-cart"></i>
          <span class="nav-icon-badge">0</span>
        </div>
        <span class="nav-icon-label">Cart</span>
      </a>
    </div>
  </div>
</nav>

<main class="main">
  <!-- Page Header -->
  <div class="page-header text-center" style="background-image: url('assets/images/page-header-bg.jpg')">
    <div class="container">
      <h1 class="page-title">Shopping Cart</h1>
    </div>
  </div>

  <!-- Breadcrumb -->
  <nav aria-label="breadcrumb" class="breadcrumb-nav">
    <div class="container">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page">Shopping Cart</li>
      </ol>
    </div>
  </nav>

  <!-- Empty Cart Content -->
  <div class="empty-cart-container">
    <div class="empty-cart-content">
      <div class="empty-cart-icon">
        <i class="icon-shopping-cart"></i>
      </div>
      
      <h2 class="empty-cart-title">Your Cart is Empty!</h2>
      <p class="empty-cart-description">
        Looks like you haven't added anything to your cart yet. 
        Start shopping and discover amazing products waiting for you!
      </p>

      <div class="empty-cart-buttons">
        <a href="/shop" class="empty-cart-btn empty-cart-btn-primary">
          <i class="icon-shopping-bag"></i>
          Start Shopping
        </a>
        <a href="/wishlist" class="empty-cart-btn empty-cart-btn-secondary">
          <i class="icon-heart-o"></i>
          View Wishlist
        </a>
      </div>
    </div>
  </div>
</main>

<%- include('../layouts/footer.ejs') %>
