<%- include('../layouts/header.ejs') %>

<style>
  .top-nav-bar {
    background: white;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    padding: 15px 0;
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  .top-nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .nav-logo img {
    height: 35px;
  }

  .nav-icons {
    display: flex;
    gap: 30px;
    align-items: center;
  }

  .nav-icon-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: #333;
    transition: all 0.3s ease;
  }

  .nav-icon-item:hover {
    color: #111827;
    transform: translateY(-2px);
  }

  .nav-icon-wrapper {
    position: relative;
    font-size: 24px;
  }

  .nav-icon-label {
    font-size: 12px;
    margin-top: 4px;
    font-weight: 500;
  }

  body {
    background: #f5f5f7;
  }

  .page-header {
    background: linear-gradient(135deg, #ffffff 0%, #9197af 100%);
    border-bottom: 2px solid #e5e7eb;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9), 0 2px 8px rgba(0, 0, 0, 0.05);
    padding: 60px 20px;
    text-align: center;
  }

  .page-title {
    font-size: 36px;
    font-weight: 700;
    margin: 0;
    color: #111827;
  }

  .breadcrumb-nav {
    background: white;
    padding: 15px 0;
    border-bottom: 1px solid #e5e7eb;
  }

  .shop-container {
    max-width: 1200px;
    margin: 30px auto;
    padding: 0 20px;
    display: flex;
    gap: 30px;
  }

  .filter-sidebar {
    width: 280px;
    flex-shrink: 0;
  }

  .filter-card {
    background: white;
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 20px;
    border: 1px solid #e5e7eb;
  }

  .filter-title {
    font-size: 16px;
    font-weight: 700;
    color: #111827;
    margin-bottom: 15px;
    padding-bottom: 10px;
    border-bottom: 1px solid #e5e7eb;
  }

  .filter-option {
    margin-bottom: 10px;
  }

  .filter-option input[type="checkbox"],
  .filter-option input[type="radio"] {
    margin-right: 8px;
  }

  .filter-option label {
    color: #374151;
    font-size: 14px;
    cursor: pointer;
  }

  .btn-apply-filters {
    width: 100%;
    padding: 10px;
    background: #111827;
    color: white;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-apply-filters:hover {
    background: #030712;
  }

  .btn-clear-filters {
    width: 100%;
    padding: 8px;
    background: white;
    color: #6b7280;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    margin-top: 10px;
    transition: all 0.2s ease;
  }

  .btn-clear-filters:hover {
    border-color: #111827;
    color: #111827;
  }

  .products-section {
    flex: 1;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 20px;
  }

  .product-card {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.3s ease;
    border: 1px solid #e5e7eb;
    position: relative;
  }

  .product-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
  }

  .product-image-wrapper {
    position: relative;
    overflow: hidden;
    padding-top: 100%;
  }

  .product-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .discount-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    background: #dc2626;
    color: white;
    padding: 6px 12px;
    border-radius: 20px;
    font-weight: 700;
    font-size: 12px;
    z-index: 10;
  }

  .wishlist-btn {
    position: absolute;
    top: 10px;
    left: 10px;
    background: white;
    border: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    z-index: 10;
  }

  .wishlist-btn:hover {
    background: #111827;
    color: white;
  }

  .product-actions {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
    padding: 20px 15px 15px;
    transform: translateY(100%);
    transition: transform 0.3s ease;
  }

  .product-card:hover .product-actions {
    transform: translateY(0);
  }

  .btn-add-cart {
    width: 100%;
    padding: 10px;
    background: white;
    color: #111827;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    font-size: 13px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-add-cart:hover {
    background: #111827;
    color: white;
  }

  .btn-add-cart.out-of-stock {
    background: #fee2e2;
    color: #dc2626;
    cursor: not-allowed;
  }

  .product-info {
    padding: 15px;
  }

  .product-name {
    font-size: 15px;
    font-weight: 600;
    color: #111827;
    margin-bottom: 8px;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-price {
    font-size: 18px;
    font-weight: 700;
    color: #111827;
  }

  .old-price {
    font-size: 14px;
    color: #9ca3af;
    text-decoration: line-through;
    margin-left: 8px;
  }
  .pagination-container {
    margin-top: 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 15px;
  }

  .pagination-nav {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .pagination-btn {
    padding: 10px 20px;
    background: white;
    color: #111827;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .pagination-btn:hover:not(.disabled) {
    background: #111827;
    color: white;
    border-color: #111827;
  }

  .pagination-btn.disabled {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
  }

  .pagination-numbers {
    display: flex;
    gap: 5px;
    align-items: center;
  }

  .pagination-number {
    min-width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: white;
    color: #374151;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    font-weight: 500;
    font-size: 14px;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .pagination-number:hover {
    border-color: #111827;
    color: #111827;
  }

  .pagination-number.active {
    background: #111827;
    color: white;
    border-color: #111827;
    font-weight: 700;
  }

  .pagination-ellipsis {
    color: #9ca3af;
    padding: 0 5px;
    font-weight: 600;
  }

  .pagination-info {
    color: #6b7280;
    font-size: 14px;
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .pagination-nav {
      flex-wrap: wrap;
      justify-content: center;
    }
    
    .pagination-btn {
      padding: 8px 15px;
      font-size: 13px;
    }
    
    .pagination-number {
      min-width: 35px;
      height: 35px;
      font-size: 13px;
    }
  }


  @media (max-width: 992px) {
    .shop-container {
      flex-direction: column;
    }

    .filter-sidebar {
      width: 100%;
    }

    .filter-card {
      display: none;
    }

    .filter-card.mobile-visible {
      display: block;
    }
  }

  @media (max-width: 768px) {
    .nav-logo img {
      height: 28px;
    }

    .nav-icon-label {
      display: none;
    }

    .page-title {
      font-size: 28px;
    }

    .product-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
    }
  }
</style>

<!-- Top Navigation -->
<nav class="top-nav-bar">
  <div class="top-nav-container">
    <a href="/" class="nav-logo">
      <img src="assets/newimages/logo.png" alt="shopEazy Logo">
    </a>

    <div class="nav-icons">
      <a href="/wallet" class="nav-icon-item">
        <div class="nav-icon-wrapper">
          <i class="fa-solid fa-wallet"></i>
        </div>
        <span class="nav-icon-label">Wallet</span>
      </a>

      <a href="/wishlist" class="nav-icon-item">
        <div class="nav-icon-wrapper">
          <i class="icon-heart-o"></i>
        </div>
        <span class="nav-icon-label">Wishlist</span>
      </a>

      <a href="/cart" class="nav-icon-item">
        <div class="nav-icon-wrapper">
          <i class="icon-shopping-cart"></i>
        </div>
        <span class="nav-icon-label">Cart</span>
      </a>
    </div>
  </div>
</nav>

<!-- Page Header -->
<div class="page-header">
  <div class="container">
    <h1 class="page-title">All Products</h1>
  </div>
</div>

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="breadcrumb-nav">
  <div class="container">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/">Home</a></li>
      <li class="breadcrumb-item active">Shop</li>
    </ol>
  </div>
</nav>

<!-- Shop Content -->
<div class="shop-container">
  <!-- Filters Sidebar -->
  <aside class="filter-sidebar">
    <form id="filter-form" action="/shop" method="GET">
      <!-- Category Filter -->
      <div class="filter-card">
        <h3 class="filter-title">Categories</h3>
        <% categories.forEach(category => { %>
          <div class="filter-option">
            <input type="checkbox" id="cat-<%= category?._id %>" name="category" value="<%= category?._id %>">
            <label for="cat-<%= category._id %>"><%= category?.category_name %></label>
          </div>
        <% }); %>
      </div>

      <!-- Sort by Name -->
      <div class="filter-card">
        <h3 class="filter-title">Sort by Name</h3>
        <div class="filter-option">
          <input type="radio" id="name-asc" name="sort" value="name_asc">
          <label for="name-asc">A - Z</label>
        </div>
        <div class="filter-option">
          <input type="radio" id="name-desc" name="sort" value="name_desc">
          <label for="name-desc">Z - A</label>
        </div>
      </div>

      <!-- Sort by Price -->
      <div class="filter-card">
        <h3 class="filter-title">Sort by Price</h3>
        <div class="filter-option">
          <input type="radio" id="price-asc" name="sort" value="price_asc">
          <label for="price-asc">Low to High</label>
        </div>
        <div class="filter-option">
          <input type="radio" id="price-desc" name="sort" value="price_desc">
          <label for="price-desc">High to Low</label>
        </div>
      </div>

      <button type="submit" class="btn-apply-filters">
        <i class="icon-filter"></i> Apply Filters
      </button>
      <button type="button" class="btn-clear-filters" onclick="clearFilters()">
        Clear All
      </button>
    </form>
  </aside>

  <!-- Products Grid -->
  <div class="products-section">
    <div class="product-grid">
      <% product.forEach(prod => { 
        let bestDiscount = 0;
        let hasDiscount = false;
        let discountedPrice = prod.price;
        
        // Check product offers
        offers.forEach((item) => {
          if (item.type === 'PRODUCT') {
            item.products.forEach((Product) => {
              if (String(prod._id) === String(Product._id) && item.discount > bestDiscount) {
                bestDiscount = item.discount;
                hasDiscount = true;
                discountedPrice = prod.price * (1 - bestDiscount / 100);
              }
            });
          }
        });
        
        // Check category offers
        offers.forEach((item) => {
          if (item.type === 'CATEGORY') {
            const categoryMatch = Array.isArray(item.category)
              ? item.category.some(category => String(prod.category) === String(category._id))
              : String(prod.category) === String(item.category._id);
            
            if (categoryMatch && item.discount > bestDiscount) {
              bestDiscount = item.discount;
              hasDiscount = true;
              discountedPrice = prod.price * (1 - bestDiscount / 100);
            }
          }
        });
      %>
        <div class="product-card">
          <div class="product-image-wrapper">
            <a href="/showProduct?id=<%= prod._id %>">
              <img src="/uploads/<%= prod.images[0] %>" alt="<%= prod.product_name %>" class="product-image">
            </a>
            
            <% if (hasDiscount) { %>
              <div class="discount-badge"><%= bestDiscount %>% OFF</div>
            <% } %>
            
            <% if (typeof userData !== 'undefined') { %>
              <button class="wishlist-btn btn-wishlist" data-product-id="<%= prod._id %>" data-user-id="<%= userData?._id %>">
                <i class="icon-heart-o"></i>
              </button>
            <% } %>
            
            <div class="product-actions">
              <% if (prod.stock === 0) { %>
                <button class="btn-add-cart out-of-stock">Out of Stock</button>
              <% } else if (typeof userData === 'undefined') { %>
                <a href="/login" class="btn-add-cart" style="display: block; text-align: center; text-decoration: none;">Login to Buy</a>
              <% } else { %>
                <button class="btn-add-cart btn-add-to-cart" data-product-id="<%= prod._id %>" data-user-id="<%= userData?._id %>">
                  Add to Cart
                </button>
              <% } %>
            </div>
          </div>

          <div class="product-info">
            <h3 class="product-name">
              <a href="/showProduct?id=<%= prod._id %>" style="text-decoration: none; color: inherit;">
                <%= prod.product_name %>
              </a>
            </h3>
            <div class="product-price">
              <% if (hasDiscount) { %>
                ₹<%= discountedPrice.toFixed(2) %>
                <span class="old-price">₹<%= prod.price.toFixed(2) %></span>
              <% } else { %>
                ₹<%= prod.price.toFixed(2) %>
              <% } %>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</div>
 <% if (totalPages > 1) { %>
  <div class="pagination-container">
    <nav class="pagination-nav">
      <!-- Previous Button -->
      <% if (currentPage > 1) { %>
        <a href="?page=<%= currentPage - 1 %><%= sort ? '&sort=' + sort : '' %><%= selectedCategories ? '&category=' + selectedCategories : '' %>" 
           class="pagination-btn pagination-prev">
          <i class="fa-solid fa-chevron-left"></i> Previous
        </a>
      <% } else { %>
        <span class="pagination-btn pagination-prev disabled">
          <i class="fa-solid fa-chevron-left"></i> Previous
        </span>
      <% } %>

      <!-- Page Numbers -->
      <div class="pagination-numbers">
          <% 
            let startPage = Math.max(1, currentPage - 2);
            let endPage = Math.min(totalPages, currentPage + 2);
            
            if (currentPage <= 3) {
              endPage = Math.min(5, totalPages);
            }
            if (currentPage >= totalPages - 2) {
              startPage = Math.max(1, totalPages - 4);
            }
          %>

          <% if (startPage > 1) { %>
            <a href="?page=1<%= sort ? '&sort=' + sort : '' %><%= selectedCategories ? '&category=' + selectedCategories : '' %>" 
              class="pagination-number">1</a>
            <% if (startPage > 2) { %>
              <span class="pagination-ellipsis">...</span>
            <% } %>
          <% } %>

          <% for (let i = startPage; i <= endPage; i++) { %>
            <a href="?page=<%= i %><%= sort ? '&sort=' + sort : '' %><%= selectedCategories ? '&category=' + selectedCategories : '' %>" 
              class="pagination-number <%= i === currentPage ? 'active' : '' %>">
              <%= i %>
            </a>
          <% } %>

          <% if (endPage < totalPages) { %>
            <% if (endPage < totalPages - 1) { %>
              <span class="pagination-ellipsis">...</span>
            <% } %>
            <a href="?page=<%= totalPages %><%= sort ? '&sort=' + sort : '' %><%= selectedCategories ? '&category=' + selectedCategories : '' %>" 
              class="pagination-number"><%= totalPages %></a>
          <% } %>
        </div>

        <!-- Next Button -->
        <% if (currentPage < totalPages) { %>
          <a href="?page=<%= currentPage + 1 %><%= sort ? '&sort=' + sort : '' %><%= selectedCategories ? '&category=' + selectedCategories : '' %>" 
            class="pagination-btn pagination-next">
            Next <i class="fa-solid fa-chevron-right"></i>
          </a>
        <% } else { %>
          <span class="pagination-btn pagination-next disabled">
            Next <i class="fa-solid fa-chevron-right"></i>
          </span>
        <% } %>
      </nav>

      <div class="pagination-info">
        Showing <%= (currentPage - 1) * 12 + 1 %>-<%= Math.min(currentPage * 12, totalProducts) %> 
        of <%= totalProducts %> products
      </div>
    </div>
  <% } %>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const currentSort = '<%= typeof sort !== "undefined" ? sort : "" %>';
    if (currentSort) {
      const radio = document.querySelector(`input[name="sort"][value="${currentSort}"]`);
      if (radio) radio.checked = true;
    }
    
    const selectedCategories = '<%= typeof selectedCategories !== "undefined" ? selectedCategories : "" %>'.split(',');
    selectedCategories.forEach(category => {
      if (category) {
        const checkbox = document.querySelector(`input[name="category"][value="${category}"]`);
        if (checkbox) checkbox.checked = true;
      }
    });
  });

  function clearFilters() {
    window.location.href = '/shop';
  }

  document.getElementById('filter-form').addEventListener('submit', function(e) {
    e.preventDefault();
    
    const formData = new FormData(this);
    const searchParams = new URLSearchParams();
    
    const categories = formData.getAll('category');
    if (categories.length > 0) {
      searchParams.append('category', categories.join(','));
    }
    
    const sort = formData.get('sort');
    if (sort) {
      searchParams.append('sort', sort);
    }
    
    window.location.href = '/shop?' + searchParams.toString();
  });

  // Add to Wishlist
  document.querySelectorAll('.btn-wishlist').forEach(button => {
    button.addEventListener('click', async function() {
      const productId = this.getAttribute('data-product-id');
      const userId = this.getAttribute('data-user-id');

      try {
        const response = await fetch('/addWishlistItem', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ productId, userId })
        });

        const data = await response.json();

        if (data.success) {
          Swal.fire({
            icon: 'success',
            title: 'Added to Wishlist!',
            confirmButtonColor: '#111827',
            timer: 2000
          });
        } else {
          Swal.fire({
            icon: 'info',
            text: data.message,
            confirmButtonColor: '#111827'
          });
        }
      } catch (error) {
        console.error('Error:', error);
      }
    });
  });

  // Add to Cart
  document.querySelectorAll('.btn-add-to-cart').forEach(button => {
    button.addEventListener('click', async function() {
      const productId = this.getAttribute('data-product-id');
      const userId = this.getAttribute('data-user-id');

      try {
        const response = await fetch('/addCartItem', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ productId, quantity: 1, userId })
        });

        const data = await response.json();

        if (data.success) {
          Swal.fire({
            icon: 'success',
            title: 'Added to Cart!',
            confirmButtonColor: '#111827',
            timer: 2000
          });
        } else {
          Swal.fire({
            icon: 'info',
            text: data.message,
            confirmButtonColor: '#111827'
          });
        }
      } catch (error) {
        console.error('Error:', error);
      }
    });
  });
</script>

<%- include('../layouts/footer.ejs') %>
