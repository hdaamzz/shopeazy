<%- include('../layouts/header.ejs') %>

<style>
  .top-nav-bar {
    background: white;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    padding: 15px 0;
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  .top-nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .nav-logo img {
    height: 35px;
  }

  .nav-icons {
    display: flex;
    gap: 30px;
    align-items: center;
  }

  .nav-icon-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: #333;
    transition: all 0.3s ease;
  }

  .nav-icon-item:hover {
    color: #111827;
    transform: translateY(-2px);
  }

  .nav-icon-wrapper {
    position: relative;
    font-size: 24px;
  }

  .nav-icon-label {
    font-size: 12px;
    margin-top: 4px;
    font-weight: 500;
  }

  body {
    background: #f5f5f7;
  }

    .page-header {
    background: linear-gradient(135deg, #ffffff 0%, #fafafa 50%, #f5f5f5 100%);
    border-bottom: 2px solid #e5e7eb;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9), 0 2px 8px rgba(0, 0, 0, 0.05);
    padding: 60px 20px;
    text-align: center;
    }

    .page-title {
    font-size: 36px;
    font-weight: 700;
    margin: 0;
    color: #111827;
    }

  .breadcrumb-nav {
    background: white;
    padding: 15px 0;
    border-bottom: 1px solid #e5e7eb;
  }

  .products-container {
    max-width: 1200px;
    margin: 30px auto;
    padding: 0 20px;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 20px;
  }

  .product-card {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.3s ease;
    border: 1px solid #e5e7eb;
    position: relative;
  }

  .product-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
  }

  .product-image-wrapper {
    position: relative;
    overflow: hidden;
    padding-top: 100%;
  }

  .product-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .discount-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    background: #dc2626;
    color: white;
    padding: 6px 12px;
    border-radius: 20px;
    font-weight: 700;
    font-size: 12px;
    z-index: 10;
  }

  .wishlist-btn {
    position: absolute;
    top: 10px;
    left: 10px;
    background: white;
    border: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    z-index: 10;
  }

  .wishlist-btn:hover {
    background: #111827;
    color: white;
  }

  .product-actions {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
    padding: 20px 15px 15px;
    transform: translateY(100%);
    transition: transform 0.3s ease;
  }

  .product-card:hover .product-actions {
    transform: translateY(0);
  }

  .btn-add-cart {
    width: 100%;
    padding: 10px;
    background: white;
    color: #111827;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    font-size: 13px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-add-cart:hover {
    background: #111827;
    color: white;
  }

  .btn-add-cart.out-of-stock {
    background: #fee2e2;
    color: #dc2626;
    cursor: not-allowed;
  }

  .product-info {
    padding: 15px;
  }

  .product-name {
    font-size: 15px;
    font-weight: 600;
    color: #111827;
    margin-bottom: 8px;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-price {
    font-size: 18px;
    font-weight: 700;
    color: #111827;
  }

  .old-price {
    font-size: 14px;
    color: #9ca3af;
    text-decoration: line-through;
    margin-left: 8px;
  }

  .empty-state {
    text-align: center;
    padding: 80px 20px;
  }

  .empty-state i {
    font-size: 80px;
    color: #d1d5db;
    margin-bottom: 20px;
  }

  .empty-state h3 {
    font-size: 24px;
    color: #6b7280;
    margin-bottom: 10px;
  }

  @media (max-width: 768px) {
    .nav-logo img {
      height: 28px;
    }

    .nav-icon-label {
      display: none;
    }

    .page-title {
      font-size: 28px;
    }

    .product-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
    }
  }
</style>

<!-- Top Navigation -->
<nav class="top-nav-bar">
  <div class="top-nav-container">
    <a href="/" class="nav-logo">
      <img src="/assets/newimages/logo.png" alt="shopEazy Logo">
    </a>

    <div class="nav-icons">
      <a href="/wallet" class="nav-icon-item">
        <div class="nav-icon-wrapper">
          <i class="fa-solid fa-wallet"></i>
        </div>
        <span class="nav-icon-label">Wallet</span>
      </a>

      <a href="/wishlist" class="nav-icon-item">
        <div class="nav-icon-wrapper">
          <i class="icon-heart-o"></i>
        </div>
        <span class="nav-icon-label">Wishlist</span>
      </a>

      <a href="/cart" class="nav-icon-item">
        <div class="nav-icon-wrapper">
          <i class="icon-shopping-cart"></i>
        </div>
        <span class="nav-icon-label">Cart</span>
      </a>
    </div>
  </div>
</nav>

<!-- Page Header -->
<div class="page-header">
  <div class="container">
    <h1 class="page-title"><%= categoryData.category_name %></h1>
  </div>
</div>

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="breadcrumb-nav">
  <div class="container">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/">Home</a></li>
      <li class="breadcrumb-item active"><%= categoryData.category_name %></li>
    </ol>
  </div>
</nav>

<!-- Products -->
<div class="products-container">
  <% if (productData && productData.length > 0) { %>
    <div class="product-grid">
      <% productData.forEach(product => { 
        let bestDiscount = 0;
        let hasDiscount = false;
        let discountedPrice = product.price;
        
        // Check product offers
        offers.forEach((item) => {
          if (item.type === 'PRODUCT') {
            item.products.forEach((Product) => {
              if (String(product._id) === String(Product._id) && item.discount > bestDiscount) {
                bestDiscount = item.discount;
                hasDiscount = true;
                discountedPrice = product.price * (1 - bestDiscount / 100);
              }
            });
          }
        });
        
        // Check category offers
        offers.forEach((item) => {
          if (item.type === 'CATEGORY') {
            const categoryMatch = item.category.some(category => 
              String(product.category) === String(category)
            );
            if (categoryMatch && item.discount > bestDiscount) {
              bestDiscount = item.discount;
              hasDiscount = true;
              discountedPrice = product.price * (1 - bestDiscount / 100);
            }
          }
        });
      %>
        <div class="product-card">
          <div class="product-image-wrapper">
            <a href="/shop/product?id=<%= product._id %>">
              <img src="/uploads/<%= product.images[0] %>" alt="<%= product.product_name %>" class="product-image">
            </a>
            
            <% if (hasDiscount) { %>
              <div class="discount-badge"><%= bestDiscount %>% OFF</div>
            <% } %>
            
            <% if (typeof userData !== 'undefined') { %>
              <button class="wishlist-btn btn-wishlist" data-product-id="<%= product._id %>" data-user-id="<%= userData._id %>">
                <i class="icon-heart-o"></i>
              </button>
            <% } %>
            
            <div class="product-actions">
              <% if (product.stock === 0) { %>
                <button class="btn-add-cart out-of-stock">Out of Stock</button>
              <% } else if (typeof userData === 'undefined') { %>
                <a href="/auth/login" class="btn-add-cart" style="display: block; text-align: center; text-decoration: none;">Login to Buy</a>
              <% } else { %>
                <button class="btn-add-cart btn-add-to-cart" data-product-id="<%= product._id %>" data-user-id="<%= userData._id %>">
                  Add to Cart
                </button>
              <% } %>
            </div>
          </div>

          <div class="product-info">
            <h3 class="product-name">
              <a href="/shop/product?id=<%= product._id %>" style="text-decoration: none; color: inherit;">
                <%= product.product_name %>
              </a>
            </h3>
            <div class="product-price">
              <% if (hasDiscount) { %>
                ₹<%= discountedPrice.toFixed(2) %>
                <span class="old-price">₹<%= product.price.toFixed(2) %></span>
              <% } else { %>
                ₹<%= product.price.toFixed(2) %>
              <% } %>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <div class="empty-state">
      <i class="icon-shopping-bag"></i>
      <h3>No Products Found</h3>
      <p>There are no products in this category yet.</p>
    </div>
  <% } %>
</div>

<!-- Scripts -->
<script>
  // Add to Wishlist
  document.querySelectorAll('.btn-wishlist').forEach(button => {
    button.addEventListener('click', async function() {
      const productId = this.getAttribute('data-product-id');
      const userId = this.getAttribute('data-user-id');

      try {
        const response = await fetch('/wishlist/add', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ productId, userId })
        });

        const data = await response.json();

        if (data.success) {
          Swal.fire({
            icon: 'success',
            title: 'Added to Wishlist!',
            text: 'Product added to your wishlist',
            confirmButtonColor: '#111827',
            timer: 2000
          });
        } else {
          Swal.fire({
            icon: 'info',
            title: 'Info',
            text: data.message,
            confirmButtonColor: '#111827'
          });
        }
      } catch (error) {
        console.error('Error:', error);
        Swal.fire({
          icon: 'error',
          title: 'Error',
          text: 'Failed to add to wishlist',
          confirmButtonColor: '#111827'
        });
      }
    });
  });

  // Add to Cart
  document.querySelectorAll('.btn-add-to-cart').forEach(button => {
    button.addEventListener('click', async function() {
      const productId = this.getAttribute('data-product-id');
      const userId = this.getAttribute('data-user-id');
      const quantity = 1;

      try {
        const response = await fetch('/cart/add', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ productId, quantity, userId })
        });

        const data = await response.json();

        if (data.success) {
          Swal.fire({
            icon: 'success',
            title: 'Added to Cart!',
            text: 'Product added to your cart',
            confirmButtonColor: '#111827',
            timer: 2000
          });
        } else {
          Swal.fire({
            icon: 'info',
            title: 'Info',
            text: data.message,
            confirmButtonColor: '#111827'
          });
        }
      } catch (error) {
        console.error('Error:', error);
        Swal.fire({
          icon: 'error',
          title: 'Error',
          text: 'Failed to add to cart',
          confirmButtonColor: '#111827'
        });
      }
    });
  });
</script>

<%- include('../layouts/footer.ejs') %>
