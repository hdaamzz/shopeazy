<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>404 - Page Not Found | shopEazy</title>
    <meta name="keywords" content="HTML5 Template">
    <meta name="description" content="Bootstrap eCommerce Template">
    <meta name="author" content="p-themes">
    
    <!-- Favicon -->
    <link rel="apple-touch-icon" sizes="180x180" href="assets/images/icons/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="assets/newimages/logo.png">
    <link rel="icon" type="image/png" sizes="16x16" href="assets/newimages/logo.png">
    <link rel="shortcut icon" href="assets/newimages/logo.png">
    
    <!-- Plugins CSS File -->
    <link rel="stylesheet" href="assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="assets/css/plugins/owl-carousel/owl.carousel.css">
    <link rel="stylesheet" href="assets/css/style.css">
    <link rel="stylesheet" href="assets/css/skins/skin-demo-4.css">
    <link rel="stylesheet" href="assets/css/demos/demo-4.css">
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" 
          integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg==" 
          crossorigin="anonymous" referrerpolicy="no-referrer" />

    <style>
        body {
            background: #ffffff;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
        }

        /* Top Navigation */
        .top-nav-bar {
            background: white;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
            padding: 15px 0;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .top-nav-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 20px;
        }

        .nav-logo img {
            height: 35px;
        }

        .nav-icons {
            display: flex;
            gap: 30px;
            align-items: center;
        }

        .nav-icon-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-decoration: none;
            color: #333;
            transition: all 0.3s ease;
        }

        .nav-icon-item:hover {
            color: #111827;
            transform: translateY(-2px);
        }

        .nav-icon-wrapper {
            font-size: 24px;
        }

        .nav-icon-label {
            font-size: 12px;
            margin-top: 4px;
            font-weight: 500;
        }

        /* 404 Content */
        .error-container {
            min-height: 80vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 60px 20px;
            background: linear-gradient(135deg, #ffffff 0%, #f9fafb 100%);
        }

        .error-content {
            text-align: center;
            max-width: 600px;
            margin: 0 auto;
        }

        .error-animation {
            margin-bottom: 40px;
            position: relative;
        }

        .error-number {
            font-size: 150px;
            font-weight: 800;
            color: #111827;
            line-height: 1;
            margin: 0;
            letter-spacing: -5px;
            background: linear-gradient(135deg, #111827 0%, #4b5563 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            position: relative;
            animation: float 3s ease-in-out infinite;
        }

        @keyframes float {
            0%, 100% {
                transform: translateY(0px);
            }
            50% {
                transform: translateY(-20px);
            }
        }

        .error-icon {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 60px;
            color: #e5e7eb;
            animation: pulse 2s ease-in-out infinite;
        }

        @keyframes pulse {
            0%, 100% {
                opacity: 0.3;
                transform: translate(-50%, -50%) scale(1);
            }
            50% {
                opacity: 0.6;
                transform: translate(-50%, -50%) scale(1.1);
            }
        }

        .error-title {
            font-size: 32px;
            font-weight: 700;
            color: #111827;
            margin-bottom: 15px;
        }

        .error-description {
            font-size: 16px;
            color: #6b7280;
            margin-bottom: 40px;
            line-height: 1.6;
        }

        .error-actions {
            display: flex;
            gap: 15px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn-primary-404 {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 14px 30px;
            background: #111827;
            color: white;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
            font-size: 15px;
            transition: all 0.3s ease;
            border: 2px solid #111827;
        }

        .btn-primary-404:hover {
            background: #030712;
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
            color: white;
        }

        .btn-secondary-404 {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 14px 30px;
            background: white;
            color: #111827;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
            font-size: 15px;
            transition: all 0.3s ease;
            border: 2px solid #e5e7eb;
        }

        .btn-secondary-404:hover {
            background: #f9fafb;
            border-color: #111827;
            transform: translateY(-2px);
            color: #111827;
        }

        .helpful-links {
            margin-top: 60px;
            padding-top: 40px;
            border-top: 2px solid #f3f4f6;
        }

        .helpful-links-title {
            font-size: 18px;
            font-weight: 700;
            color: #111827;
            margin-bottom: 20px;
        }

        .quick-links {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            max-width: 500px;
            margin: 0 auto;
        }

        .quick-link {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 20px;
            background: white;
            border: 2px solid #f3f4f6;
            border-radius: 8px;
            text-decoration: none;
            color: #6b7280;
            font-weight: 500;
            transition: all 0.2s ease;
        }

        .quick-link:hover {
            background: #f9fafb;
            border-color: #111827;
            color: #111827;
            transform: translateX(5px);
        }

        .quick-link i {
            font-size: 18px;
        }

        /* Footer */
        .footer-404 {
            background: white;
            border-top: 1px solid #e5e7eb;
            padding: 30px 20px;
            text-align: center;
        }

        .footer-404 p {
            color: #6b7280;
            font-size: 14px;
            margin: 0;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .nav-icon-label {
                display: none;
            }

            .error-number {
                font-size: 100px;
            }

            .error-title {
                font-size: 24px;
            }

            .error-description {
                font-size: 14px;
            }

            .error-actions {
                flex-direction: column;
            }

            .btn-primary-404,
            .btn-secondary-404 {
                width: 100%;
                justify-content: center;
            }

            .quick-links {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>
    <div class="page-wrapper">
        <!-- Top Navigation -->
        <nav class="top-nav-bar">
            <div class="top-nav-container">
                <a href="/" class="nav-logo">
                    <img src="assets/newimages/logo.png" alt="shopEazy Logo">
                </a>

                <div class="nav-icons">
                    <a href="/wallet" class="nav-icon-item">
                        <div class="nav-icon-wrapper">
                            <i class="fa-solid fa-wallet"></i>
                        </div>
                        <span class="nav-icon-label">Wallet</span>
                    </a>

                    <a href="/wishlist" class="nav-icon-item">
                        <div class="nav-icon-wrapper">
                            <i class="icon-heart-o"></i>
                        </div>
                        <span class="nav-icon-label">Wishlist</span>
                    </a>

                    <a href="/cart" class="nav-icon-item">
                        <div class="nav-icon-wrapper">
                            <i class="icon-shopping-cart"></i>
                        </div>
                        <span class="nav-icon-label">Cart</span>
                    </a>

                    <a href="/dashboard" class="nav-icon-item">
                        <div class="nav-icon-wrapper">
                            <i class="icon-user"></i>
                        </div>
                        <span class="nav-icon-label">Account</span>
                    </a>
                </div>
            </div>
        </nav>

        <!-- 404 Error Content -->
        <div class="error-container">
            <div class="error-content">
                <!-- Error Animation -->
                <div class="error-animation">
                    <h1 class="error-number">404</h1>
                    <div class="error-icon">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </div>
                </div>

                <!-- Error Message -->
                <h2 class="error-title">Oops! Page Not Found</h2>
                <p class="error-description">
                    The page you're looking for seems to have wandered off. 
                    Don't worry though, there are plenty of other great products waiting for you!
                </p>

                <!-- Action Buttons -->
                <div class="error-actions">
                    <a href="/" class="btn-primary-404">
                        <i class="fa-solid fa-home"></i>
                        Back to Home
                    </a>
                    <a href="/shop" class="btn-secondary-404">
                        <i class="fa-solid fa-shopping-bag"></i>
                        Continue Shopping
                    </a>
                </div>

                <!-- Helpful Links -->
                <div class="helpful-links">
                    <h3 class="helpful-links-title">Or try these helpful links:</h3>
                    <div class="quick-links">
                        <a href="/shop" class="quick-link">
                            <i class="fa-solid fa-store"></i>
                            <span>Shop All Products</span>
                        </a>
                        <a href="/wishlist" class="quick-link">
                            <i class="fa-solid fa-heart"></i>
                            <span>My Wishlist</span>
                        </a>
                        <a href="/cart" class="quick-link">
                            <i class="fa-solid fa-cart-shopping"></i>
                            <span>Shopping Cart</span>
                        </a>
                        <a href="/dashboard" class="quick-link">
                            <i class="fa-solid fa-user"></i>
                            <span>My Account</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <footer class="footer-404">
            <div class="container">
                <p>Copyright © 2024 shopEazy Store. All Rights Reserved.</p>
            </div>
        </footer>
    </div>

    <!-- Plugins JS File -->
    <script src="assets/js/jquery.min.js"></script>
    <script src="assets/js/bootstrap.bundle.min.js"></script>
    <script src="assets/js/main.js"></script>
</body>

</html>
