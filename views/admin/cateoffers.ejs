<!DOCTYPE html>
<html lang="en" class="light-style layout-navbar-fixed layout-menu-fixed layout-compact" dir="ltr"
    data-theme="theme-default" data-assets-path="/dashboard-assets/" data-template="vertical-menu-template"
    data-style="light">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />
    <title>Category Offers - shopEazy</title>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="icon" type="image/x-icon" href="/assets/newimages/logo.png" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com/">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Icons -->
    <link rel="stylesheet" href="/dashboard-assets/vendor/fonts/remixicon/remixicon.css" />

    <!-- Core CSS -->
    <link rel="stylesheet" href="/dashboard-assets/vendor/css/rtl/core.css" class="template-customizer-core-css" />
    <link rel="stylesheet" href="/dashboard-assets/vendor/css/rtl/theme-default.css" class="template-customizer-theme-css" />
    <link rel="stylesheet" href="/dashboard-assets/css/demo.css" />

    <!-- Vendors CSS -->
    <link rel="stylesheet" href="/dashboard-assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

    <style>
        /* Error Styles */
        .is-invalid {
            border-color: #dc3545 !important;
        }

        .is-valid {
            border-color: #28a745 !important;
        }

        .error-message {
            color: #dc3545;
            font-size: 0.875rem;
            margin-top: 0.25rem;
            display: block;
        }

        /* Select2 Styles */
        .select2-container--default .select2-selection--multiple {
            border: 1px solid #d9dee3;
            border-radius: 0.375rem;
            padding: 0.3rem 0.5rem;
            min-height: 38px;
        }

        .select2-container--default.select2-container--focus .select2-selection--multiple {
            border-color: #696cff;
        }

        .select2-container--default .select2-selection--multiple.is-invalid {
            border-color: #dc3545 !important;
        }

        .select2-container--default .select2-selection--multiple .select2-selection__choice {
            background-color: #696cff;
            border: none;
            color: white;
            border-radius: 0.25rem;
            padding: 3px 8px;
            margin: 2px;
        }

        .select2-container--default .select2-selection--multiple .select2-selection__choice__remove {
            color: white;
            margin-right: 5px;
        }

        /* Offer Card Styles */
        .offer-card {
            transition: all 0.3s ease;
            border: none;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
            height: 100%;
        }

        .offer-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
        }

        .offer-card .card-title {
            color: #333;
            font-size: 1.25rem;
            font-weight: 600;
            margin-bottom: 1rem;
            padding-bottom: 0.75rem;
            border-bottom: 2px solid #f0f0f0;
        }

        .offer-card .discount {
            font-size: 1.5rem;
            color: #696cff;
            font-weight: 700;
        }

        .status-badge {
            padding: 0.35rem 0.75rem;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
        }

        .status-badge.active {
            background-color: #28a745;
            color: white;
        }

        .status-badge.inactive {
            background-color: #dc3545;
            color: white;
        }

        /* Modal Styles */
        .modal-header {
            border-bottom: 1px solid #e9ecef;
            padding: 1.5rem;
        }

        .modal-body {
            padding: 1.5rem !important;
        }

        .form-label {
            font-weight: 500;
            margin-bottom: 0.5rem;
            color: #566a7f;
        }

        /* Ensure Select2 is visible */
        .select2-container {
            z-index: 9999;
        }

        .select2-dropdown {
            z-index: 10000;
        }
    </style>
</head>

<body>
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">

            <!-- Menu -->
            <aside id="layout-menu" class="layout-menu menu-vertical menu bg-menu-theme">
                <div class="app-brand demo">
                    <a href="/admin/adminHome" class="app-brand-link">
                        <img src="/assets/newimages/logo.png" width="150px" height="40px">
                    </a>
                    <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large ms-auto">
                        <i class="menu-toggle-icon d-xl-block align-middle"></i>
                    </a>
                </div>

                <div class="menu-inner-shadow"></div>

                <ul class="menu-inner py-1">
                    <li class="menu-item active open">
                        <a href="javascript:void(0);" class="menu-link menu-toggle">
                            <i class='menu-icon tf-icons ri-shopping-bag-3-line'></i>
                            <div data-i18n="shopEazy">shopEazy</div>
                        </a>
                        <ul class="menu-sub">
                            <li class="menu-item">
                                <a href="/admin/adminHome" class="menu-link">
                                    <div data-i18n="Dashboard">Dashboard</div>
                                </a>
                            </li>
                            <li class="menu-item">
                                <a href="/admin/products" class="menu-link menu-toggle">
                                    <div data-i18n="Products">Products</div>
                                </a>
                                <ul class="menu-sub">
                                    <li class="menu-item">
                                        <a href="/admin/products" class="menu-link">
                                            <div data-i18n="Product List">Product List</div>
                                        </a>
                                    </li>
                                    <li class="menu-item">
                                        <a href="/admin/addProduct" class="menu-link">
                                            <div data-i18n="Add Product">Add Product</div>
                                        </a>
                                    </li>
                                </ul>
                            </li>
                            <li class="menu-item">
                                <a href="/admin/category" class="menu-link menu-toggle">
                                    <div data-i18n="Category">Category</div>
                                </a>
                                <ul class="menu-sub">
                                    <li class="menu-item">
                                        <a href="/admin/category" class="menu-link">
                                            <div data-i18n="List all category">List all category</div>
                                        </a>
                                    </li>
                                </ul>
                            </li>
                            <li class="menu-item">
                                <a href="/admin/orders" class="menu-link menu-toggle">
                                    <div data-i18n="Order">Order</div>
                                </a>
                                <ul class="menu-sub">
                                    <li class="menu-item">
                                        <a href="/admin/orders" class="menu-link">
                                            <div data-i18n="Order List">Order List</div>
                                        </a>
                                    </li>
                                </ul>
                            </li>
                            <li class="menu-item">
                                <a href="/admin/allCustomers" class="menu-link menu-toggle">
                                    <div data-i18n="Customer">Customer</div>
                                </a>
                                <ul class="menu-sub">
                                    <li class="menu-item">
                                        <a href="/admin/allCustomers" class="menu-link">
                                            <div data-i18n="All Customers">All Customers</div>
                                        </a>
                                    </li>
                                </ul>
                            </li>
                            <li class="menu-item active open">
                                <a href="javascript:void(0);" class="menu-link menu-toggle">
                                    <div data-i18n="Offers">Offers</div>
                                </a>
                                <ul class="menu-sub">
                                    <li class="menu-item">
                                        <a href="/admin/offers" class="menu-link">
                                            <div data-i18n="Product Offers">Product Offers</div>
                                        </a>
                                    </li>
                                    <li class="menu-item active">
                                        <a href="/admin/offers/category" class="menu-link">
                                            <div data-i18n="Category Offers">Category Offers</div>
                                        </a>
                                    </li>
                                </ul>
                            </li>
                            <li class="menu-item">
                                <a href="/admin/coupons" class="menu-link menu-toggle">
                                    <div data-i18n="Coupons Management">Coupons Management</div>
                                </a>
                                <ul class="menu-sub">
                                    <li class="menu-item">
                                        <a href="/admin/coupons" class="menu-link">
                                            <div data-i18n="Coupen">Coupen</div>
                                        </a>
                                    </li>
                                </ul>
                            </li>
                            <li class="menu-item">
                                <a href="/admin/salesreport"  class="menu-link menu-toggle">
                                    <div data-i18n="Sales Report">Sales Report</div>
                                </a>
                                <ul class="menu-sub">
                                    <li class="menu-item">
                                        <a href="/admin/salesreport" class="menu-link">
                                            <div data-i18n="Report">Report</div>
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    </li>
                </ul>
            </aside>
            <!-- / Menu -->

            <!-- Layout page -->
            <div class="layout-page">
                <!-- Navbar -->
                <nav class="layout-navbar container-xxl navbar navbar-expand-xl navbar-detached align-items-center bg-navbar-theme" id="layout-navbar">
                    <div class="navbar-nav-right d-flex align-items-center" id="navbar-collapse">
                        <ul class="navbar-nav flex-row align-items-center ms-auto">
                            <li class="nav-item navbar-dropdown dropdown-user dropdown">
                                <a class="nav-link dropdown-toggle hide-arrow p-0" href="javascript:void(0);" data-bs-toggle="dropdown">
                                    <div class="avatar avatar-online">
                                        <img src="/dashboard-assets/img/avatars/1.png" alt class="w-px-40 h-auto rounded-circle">
                                    </div>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end mt-3 py-2">
                                    <li>
                                        <a class="dropdown-item" href="#">
                                            <div class="d-flex align-items-center">
                                                <div class="flex-shrink-0 me-2">
                                                    <div class="avatar avatar-online">
                                                        <img src="/dashboard-assets/img/avatars/1.png" alt class="w-px-40 h-auto rounded-circle">
                                                    </div>
                                                </div>
                                                <div class="flex-grow-1">
                                                    <small class="text-muted">Admin</small>
                                                </div>
                                            </div>
                                        </a>
                                    </li>
                                    <li>
                                        <div class="dropdown-divider"></div>
                                    </li>
                                    <li>
                                        <div class="d-grid px-4 pt-2 pb-1">
                                            <a class="btn btn-danger d-flex" href="/admin/logout">
                                                <small class="align-middle">Logout</small>
                                                <i class="ri-logout-box-r-line ms-2 ri-16px"></i>
                                            </a>
                                        </div>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                </nav>
                <!-- / Navbar -->

                <!-- Content wrapper -->
                <div class="container-xxl flex-grow-1 container-p-y">

                    <!-- Header Card -->
                    <div class="card mb-4">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">Category Offers Management</h5>
                            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addOfferModal">
                                <i class="ri-add-line me-1"></i>Add Offer
                            </button>
                        </div>

                        <!-- Search and Sort Controls -->
                        <div class="card-body border-top">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label">Search</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="ri-search-line"></i></span>
                                        <input type="text" class="form-control" id="searchInput" placeholder="Search offers..." value="<%= search %>">
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Sort By</label>
                                    <select class="form-select" id="sortBy">
                                        <option value="createdAt" <%= sortBy === 'createdAt' ? 'selected' : '' %>>Date Created</option>
                                        <option value="title" <%= sortBy === 'title' ? 'selected' : '' %>>Title</option>
                                        <option value="discount" <%= sortBy === 'discount' ? 'selected' : '' %>>Discount</option>
                                        <option value="status" <%= sortBy === 'status' ? 'selected' : '' %>>Status</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Order</label>
                                    <select class="form-select" id="sortOrder">
                                        <option value="desc" <%= sortOrder === 'desc' ? 'selected' : '' %>>Descending</option>
                                        <option value="asc" <%= sortOrder === 'asc' ? 'selected' : '' %>>Ascending</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Offers Grid -->
                    <% if (offer.length === 0) { %>
                        <div class="card">
                            <div class="card-body text-center py-5">
                                <i class="ri-gift-line" style="font-size: 64px; color: #d3d3d3;"></i>
                                <h5 class="mt-3">No Offers Found</h5>
                                <p class="text-muted">Create your first category offer to get started</p>
                            </div>
                        </div>
                    <% } else { %>
                        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-4">
                            <% offer.forEach((off) => { %>
                                <div class="col">
                                    <div class="offer-card card">
                                        <div class="card-body">
                                            <h5 class="card-title"><%= off.title %></h5>
                                            <p class="text-muted mb-3"><%= off.description %></p>
                                            
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <div>
                                                    <small class="text-muted d-block">Discount</small>
                                                    <span class="discount"><%= off.discount %>%</span>
                                                </div>
                                                <div>
                                                    <small class="text-muted d-block">Status</small>
                                                    <span class="status-badge <%= off.status %>"><%= off.status %></span>
                                                </div>
                                            </div>

                                            <small class="text-muted d-block mb-3">
                                                <i class="ri-calendar-line me-1"></i>
                                                Created: <%= new Date(off.createdAt).toLocaleDateString("en-US", {year: "numeric", month: "short", day: "numeric"}) %>
                                            </small>

                                            <div class="d-flex gap-2">
                                                <button class="btn btn-sm btn-primary flex-fill" data-bs-toggle="modal" data-bs-target="#editOfferModal<%= off._id %>">
                                                    <i class="ri-edit-line"></i> Edit
                                                </button>
                                                <button class="btn btn-sm btn-danger delete-offer" data-offer-id="<%= off._id %>">
                                                    <i class="ri-delete-bin-line"></i> Delete
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>

                        <!-- Pagination -->
                        <% if (totalPages > 1) { %>
                            <div class="card">
                                <div class="card-body">
                                    <nav aria-label="Page navigation">
                                        <ul class="pagination justify-content-center mb-0">
                                            <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                                                <a class="page-link" href="#" data-page="<%= currentPage - 1 %>">
                                                    <i class="ri-arrow-left-s-line"></i> Previous
                                                </a>
                                            </li>

                                            <% for (let i = 1; i <= totalPages; i++) { %>
                                                <% if (i === 1 || i === totalPages || (i >= currentPage - 2 && i <= currentPage + 2)) { %>
                                                    <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                                                        <a class="page-link" href="#" data-page="<%= i %>"><%= i %></a>
                                                    </li>
                                                <% } else if (i === currentPage - 3 || i === currentPage + 3) { %>
                                                    <li class="page-item disabled">
                                                        <span class="page-link">...</span>
                                                    </li>
                                                <% } %>
                                            <% } %>

                                            <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                                                <a class="page-link" href="#" data-page="<%= currentPage + 1 %>">
                                                    Next <i class="ri-arrow-right-s-line"></i>
                                                </a>
                                            </li>
                                        </ul>
                                    </nav>
                                    <div class="text-center text-muted mt-3">
                                        <small>Showing <%= offer.length %> of <%= totalOffers %> offers (Page <%= currentPage %> of <%= totalPages %>)</small>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    <% } %>

                </div>
                <!-- / Content wrapper -->
            </div>
            <!-- / Layout page -->

        </div>
    </div>

    <!-- Add Offer Modal -->
    <div class="modal fade" id="addOfferModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add New Category Offer</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="addOfferForm" novalidate>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="addOfferTitle" class="form-label">Offer Title <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="addOfferTitle" placeholder="Enter offer title">
                            <div class="error-message" id="addOfferTitleError"></div>
                        </div>

                        <div class="mb-3">
                            <label for="addOfferDescription" class="form-label">Description <span class="text-danger">*</span></label>
                            <textarea class="form-control" id="addOfferDescription" rows="3" placeholder="Enter offer description"></textarea>
                            <div class="error-message" id="addOfferDescriptionError"></div>
                        </div>

                        <div class="mb-3">
                            <label for="addOfferDiscount" class="form-label">Discount (%) <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="addOfferDiscount" placeholder="Enter discount percentage" min="0" max="90">
                            <div class="error-message" id="addOfferDiscountError"></div>
                        </div>

                        <div class="mb-3">
                            <label for="addCategorySelect" class="form-label">Categories <span class="text-danger">*</span></label>
                            <select class="form-select" id="addCategorySelect" multiple>
                                <% category.forEach(item => { %>
                                    <option value="<%= item._id %>"><%= item.category_name %></option>
                                <% }) %>
                            </select>
                            <div class="error-message" id="addCategorySelectError"></div>
                        </div>

                        <div class="mb-3">
                            <label for="addOfferStatus" class="form-label">Status <span class="text-danger">*</span></label>
                            <select class="form-select" id="addOfferStatus">
                                <option value="">Select status</option>
                                <option value="active">Active</option>
                                <option value="inactive">Inactive</option>
                            </select>
                            <div class="error-message" id="addOfferStatusError"></div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary" id="addOfferBtn">
                            <i class="ri-add-line me-1"></i>Add Offer
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Edit Offer Modals -->
    <% offer.forEach(off => { %>
        <div class="modal fade" id="editOfferModal<%= off._id %>" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Edit Offer</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form class="edit-offer-form" data-offer-id="<%= off._id %>" novalidate>
                        <div class="modal-body">
                            <div class="mb-3">
                                <label for="editOfferTitle<%= off._id %>" class="form-label">Offer Title <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="editOfferTitle<%= off._id %>" value="<%= off.title %>" placeholder="Enter offer title">
                                <div class="error-message" id="editOfferTitleError<%= off._id %>"></div>
                            </div>

                            <div class="mb-3">
                                <label for="editOfferDescription<%= off._id %>" class="form-label">Description <span class="text-danger">*</span></label>
                                <textarea class="form-control" id="editOfferDescription<%= off._id %>" rows="3" placeholder="Enter offer description"><%= off.description %></textarea>
                                <div class="error-message" id="editOfferDescriptionError<%= off._id %>"></div>
                            </div>

                            <div class="mb-3">
                                <label for="editOfferDiscount<%= off._id %>" class="form-label">Discount (%) <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" id="editOfferDiscount<%= off._id %>" value="<%= off.discount %>" min="0" max="90" placeholder="Enter discount percentage">
                                <div class="error-message" id="editOfferDiscountError<%= off._id %>"></div>
                            </div>

                            <div class="mb-3">
                                <label for="editCategorySelect<%= off._id %>" class="form-label">Categories <span class="text-danger">*</span></label>
                                <select class="form-select" id="editCategorySelect<%= off._id %>" multiple>
                                    <% category.forEach(item => {
                                        const isSelected = off.category && off.category.some(catId => catId.toString() === item._id.toString());
                                    %>
                                        <option value="<%= item._id %>" <%= isSelected ? 'selected' : '' %>>
                                            <%= item.category_name %>
                                        </option>
                                    <% }) %>
                                </select>
                                <div class="error-message" id="editCategorySelectError<%= off._id %>"></div>
                            </div>

                            <div class="mb-3">
                                <label for="editOfferStatus<%= off._id %>" class="form-label">Status <span class="text-danger">*</span></label>
                                <select class="form-select" id="editOfferStatus<%= off._id %>">
                                    <option value="">Select status</option>
                                    <option value="active" <%= off.status === 'active' ? 'selected' : '' %>>Active</option>
                                    <option value="inactive" <%= off.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
                                </select>
                                <div class="error-message" id="editOfferStatusError<%= off._id %>"></div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary">
                                <i class="ri-save-line me-1"></i>Update Offer
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    <% }) %>

    <!-- Core JS -->
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="/dashboard-assets/vendor/libs/popper/popper.js"></script>
    <script src="/dashboard-assets/vendor/js/bootstrap.js"></script>
    <script src="/dashboard-assets/vendor/libs/node-waves/node-waves.js"></script>
    <script src="/dashboard-assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
    <script src="/dashboard-assets/vendor/libs/hammer/hammer.js"></script>
    <script src="/dashboard-assets/vendor/js/menu.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="/dashboard-assets/js/main.js"></script>

    <script>
        $(document).ready(function() {
            'use strict';

            // ==================== UTILITY FUNCTIONS ====================
            
            function showError(fieldId, message) {
                $(`#${fieldId}`).addClass('is-invalid').removeClass('is-valid');
                $(`#${fieldId}Error`).text(message).show();
            }

            function showSuccess(fieldId) {
                $(`#${fieldId}`).addClass('is-valid').removeClass('is-invalid');
                $(`#${fieldId}Error`).text('').hide();
            }

            function clearErrors(formId) {
                $(`#${formId} .form-control, #${formId} .form-select`).removeClass('is-invalid is-valid');
                $(`#${formId} .error-message`).text('').hide();
                $(`#${formId} .select2-selection--multiple`).removeClass('is-invalid is-valid');
            }

            function validateField(value, fieldId, rules) {
                if (!value || value.trim() === '') {
                    showError(fieldId, rules.required);
                    return false;
                }

                if (rules.minLength && value.trim().length < rules.minLength) {
                    showError(fieldId, rules.minLengthMsg);
                    return false;
                }

                if (rules.pattern && !rules.pattern.test(value)) {
                    showError(fieldId, rules.patternMsg);
                    return false;
                }

                if (rules.min !== undefined && parseFloat(value) < rules.min) {
                    showError(fieldId, rules.minMsg);
                    return false;
                }

                if (rules.max !== undefined && parseFloat(value) > rules.max) {
                    showError(fieldId, rules.maxMsg);
                    return false;
                }

                showSuccess(fieldId);
                return true;
            }

            function validateSelectField(value, fieldId, errorMsg) {
                if (!value || (Array.isArray(value) && value.length === 0)) {
                    $(`#${fieldId}`).next('.select2-container').find('.select2-selection').addClass('is-invalid');
                    showError(fieldId, errorMsg);
                    return false;
                }
                $(`#${fieldId}`).next('.select2-container').find('.select2-selection').removeClass('is-invalid').addClass('is-valid');
                showSuccess(fieldId);
                return true;
            }

            // ==================== INITIALIZE SELECT2 ====================
            
            function initSelect2() {
                // Add Modal Select2
                $('#addCategorySelect').select2({
                    placeholder: 'Select categories',
                    allowClear: true,
                    dropdownParent: $('#addOfferModal'),
                    width: '100%'
                });

                $('#addOfferStatus').select2({
                    placeholder: 'Select status',
                    minimumResultsForSearch: Infinity,
                    dropdownParent: $('#addOfferModal'),
                    width: '100%'
                });

                // Edit Modals Select2
                $('.edit-offer-form').each(function() {
                    const offerId = $(this).data('offer-id');
                    $(`#editCategorySelect${offerId}`).select2({
                        placeholder: 'Select categories',
                        allowClear: true,
                        dropdownParent: $(`#editOfferModal${offerId}`),
                        width: '100%'
                    });

                    $(`#editOfferStatus${offerId}`).select2({
                        placeholder: 'Select status',
                        minimumResultsForSearch: Infinity,
                        dropdownParent: $(`#editOfferModal${offerId}`),
                        width: '100%'
                    });
                });
            }

            initSelect2();

            // ==================== SEARCH, SORT & PAGINATION ====================
            
            let searchTimeout;
            
            $('#searchInput').on('input', function() {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(() => {
                    updateUrlParams();
                }, 500);
            });

            $('#sortBy, #sortOrder').on('change', function() {
                updateUrlParams();
            });

            function updateUrlParams() {
                const params = new URLSearchParams(window.location.search);
                params.set('search', $('#searchInput').val());
                params.set('sortBy', $('#sortBy').val());
                params.set('sortOrder', $('#sortOrder').val());
                params.set('page', '1');
                window.location.search = params.toString();
            }

            // Pagination
            $('.pagination .page-link').on('click', function(e) {
                e.preventDefault();
                if ($(this).parent().hasClass('disabled')) return;
                
                const page = $(this).data('page');
                const params = new URLSearchParams(window.location.search);
                params.set('page', page);
                window.location.search = params.toString();
            });

            // ==================== ADD OFFER ====================
            
            $('#addOfferForm').on('submit', async function(e) {
                e.preventDefault();
                clearErrors('addOfferForm');

                const title = $('#addOfferTitle').val().trim();
                const description = $('#addOfferDescription').val().trim();
                const discount = $('#addOfferDiscount').val().trim();
                const categories = $('#addCategorySelect').val();
                const status = $('#addOfferStatus').val();

                let isValid = true;

                // Validate Title
                isValid = validateField(title, 'addOfferTitle', {
                    required: 'Offer title is required',
                    minLength: 3,
                    minLengthMsg: 'Title must be at least 3 characters',
                    pattern: /^[a-zA-Z0-9\s]+$/,
                    patternMsg: 'Title can only contain letters, numbers and spaces'
                }) && isValid;

                // Validate Description
                isValid = validateField(description, 'addOfferDescription', {
                    required: 'Description is required',
                    minLength: 10,
                    minLengthMsg: 'Description must be at least 10 characters'
                }) && isValid;

                // Validate Discount
                isValid = validateField(discount, 'addOfferDiscount', {
                    required: 'Discount is required',
                    min: 0,
                    minMsg: 'Discount cannot be negative',
                    max: 90,
                    maxMsg: 'Discount cannot exceed 90%'
                }) && isValid;

                // Validate Categories
                isValid = validateSelectField(categories, 'addCategorySelect', 'Please select at least one category') && isValid;

                // Validate Status
                isValid = validateSelectField(status, 'addOfferStatus', 'Please select a status') && isValid;

                if (!isValid) return;

                // Show loading
                const $btn = $('#addOfferBtn');
                const originalText = $btn.html();
                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Adding...');

                try {
                    const response = await fetch('/admin/offers/addOffers', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            title,
                            description,
                            discount,
                            products: categories,
                            status,
                            type: 'CATEGORY'
                        })
                    });

                    const data = await response.json();

                    if (data.success) {
                        await Swal.fire({
                            icon: 'success',
                            title: 'Success!',
                            text: data.message,
                            timer: 1500,
                            showConfirmButton: false
                        });
                        window.location.href = data.redirectUrl;
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error!',
                            text: data.message
                        });
                        $btn.prop('disabled', false).html(originalText);
                    }
                } catch (error) {
                    console.error('Error:', error);
                    Swal.fire({
                        icon: 'error',
                        title: 'Error!',
                        text: 'An error occurred while adding the offer'
                    });
                    $btn.prop('disabled', false).html(originalText);
                }
            });

            // Reset form when modal closes
            $('#addOfferModal').on('hidden.bs.modal', function() {
                $('#addOfferForm')[0].reset();
                $('#addCategorySelect, #addOfferStatus').val(null).trigger('change');
                clearErrors('addOfferForm');
            });

            // ==================== EDIT OFFER ====================
            
            $('.edit-offer-form').on('submit', async function(e) {
                e.preventDefault();
                const offerId = $(this).data('offer-id');
                clearErrors(`editOfferForm${offerId}`);

                const title = $(`#editOfferTitle${offerId}`).val().trim();
                const description = $(`#editOfferDescription${offerId}`).val().trim();
                const discount = $(`#editOfferDiscount${offerId}`).val().trim();
                const categories = $(`#editCategorySelect${offerId}`).val();
                const status = $(`#editOfferStatus${offerId}`).val();

                let isValid = true;

                // Validate fields
                isValid = validateField(title, `editOfferTitle${offerId}`, {
                    required: 'Offer title is required',
                    minLength: 3,
                    minLengthMsg: 'Title must be at least 3 characters',
                    pattern: /^[a-zA-Z0-9\s]+$/,
                    patternMsg: 'Title can only contain letters, numbers and spaces'
                }) && isValid;

                isValid = validateField(description, `editOfferDescription${offerId}`, {
                    required: 'Description is required',
                    minLength: 10,
                    minLengthMsg: 'Description must be at least 10 characters'
                }) && isValid;

                isValid = validateField(discount, `editOfferDiscount${offerId}`, {
                    required: 'Discount is required',
                    min: 0,
                    minMsg: 'Discount cannot be negative',
                    max: 90,
                    maxMsg: 'Discount cannot exceed 90%'
                }) && isValid;

                isValid = validateSelectField(categories, `editCategorySelect${offerId}`, 'Please select at least one category') && isValid;
                isValid = validateSelectField(status, `editOfferStatus${offerId}`, 'Please select a status') && isValid;

                if (!isValid) return;

                // Show loading
                const $btn = $(this).find('button[type="submit"]');
                const originalText = $btn.html();
                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Updating...');

                try {
                    const response = await fetch('/admin/updateOffer', {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            id: offerId,
                            title,
                            description,
                            discount,
                            products: categories,
                            status,
                            type: 'CATEGORY'
                        })
                    });

                    const data = await response.json();

                    if (data.success) {
                        await Swal.fire({
                            icon: 'success',
                            title: 'Success!',
                            text: data.message,
                            timer: 1500,
                            showConfirmButton: false
                        });
                        window.location.reload();
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error!',
                            text: data.message
                        });
                        $btn.prop('disabled', false).html(originalText);
                    }
                } catch (error) {
                    console.error('Error:', error);
                    Swal.fire({
                        icon: 'error',
                        title: 'Error!',
                        text: 'An error occurred while updating the offer'
                    });
                    $btn.prop('disabled', false).html(originalText);
                }
            });

            // ==================== DELETE OFFER ====================
            
            $('.delete-offer').on('click', async function() {
                const offerId = $(this).data('offer-id');

                const result = await Swal.fire({
                    title: 'Are you sure?',
                    text: "You won't be able to revert this!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#696cff',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Yes, delete it!',
                    cancelButtonText: 'Cancel'
                });

                if (result.isConfirmed) {
                    try {
                        const response = await fetch('/admin/deleteOffer', {
                            method: 'DELETE',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ id: offerId })
                        });

                        const data = await response.json();

                        if (data.success) {
                            await Swal.fire({
                                icon: 'success',
                                title: 'Deleted!',
                                text: 'Offer has been deleted successfully',
                                timer: 1500,
                                showConfirmButton: false
                            });
                            window.location.reload();
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error!',
                                text: data.message
                            });
                        }
                    } catch (error) {
                        console.error('Error:', error);
                        Swal.fire({
                            icon: 'error',
                            title: 'Error!',
                            text: 'An error occurred while deleting the offer'
                        });
                    }
                }
            });
        });
    </script>
</body>
</html>
