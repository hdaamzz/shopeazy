                <!-- Page JS -->
                <script src="/dashboard-assets/js/app-ecommerce-dashboard.js"></script>



                <script>
                    document.addEventListener('DOMContentLoaded', function () {
                        // Search, Sort, and Pagination Handler
                        let searchTimeout;
                        const searchInput = document.getElementById('searchInput');
                        const sortBy = document.getElementById('sortBy');
                        const sortOrder = document.getElementById('sortOrder');

                        function updateUrl() {
                            const params = new URLSearchParams(window.location.search);
                            params.set('search', searchInput.value);
                            params.set('sortBy', sortBy.value);
                            params.set('sortOrder', sortOrder.value);
                            params.set('page', '1');
                            window.location.search = params.toString();
                        }

                        searchInput.addEventListener('input', function () {
                            clearTimeout(searchTimeout);
                            searchTimeout = setTimeout(updateUrl, 1500);
                        });

                        sortBy.addEventListener('change', updateUrl);
                        sortOrder.addEventListener('change', updateUrl);

                        // Pagination
                        document.querySelectorAll('.pagination .page-link').forEach(link => {
                            link.addEventListener('click', function (e) {
                                e.preventDefault();
                                if (this.parentElement.classList.contains('disabled')) return;

                                const page = this.getAttribute('data-page');
                                const params = new URLSearchParams(window.location.search);
                                params.set('page', page);
                                window.location.search = params.toString();
                            });
                        });

                        document.querySelectorAll('.modal').forEach(modal => {
                        modal.addEventListener('hidden.bs.modal', function () {
                            const form = this.querySelector('form');
                            if (form) {
                                form.reset();
                                // Clear all error/success states
                                form.querySelectorAll('.error').forEach(el => {
                                    el.classList.remove('error');
                                });
                                form.querySelectorAll('.success').forEach(el => {
                                    el.classList.remove('success');
                                });
                                // Reset labels to default text
                                form.querySelectorAll('label.errMsg').forEach(label => {
                                    const forAttr = label.getAttribute('for');
                                    if (forAttr) {
                                        const originalText = label.textContent.split(':')[0].trim();
                                        label.textContent = originalText || label.textContent;
                                    }
                                });
                            }
                        });
                    });

                        // Form validation helpers
                        const setError = (element, message) => {
                            const formGroup = element.parentElement;
                            const errorDisplay = formGroup.querySelector('.errMsg');
                            if (errorDisplay) {
                                errorDisplay.innerText = message;
                                element.classList.add('error');
                                errorDisplay.classList.add('error');
                                element.classList.remove('success');
                                errorDisplay.classList.remove('success');
                            }
                        };

                        const setSuccess = (element, message) => {
                            const formGroup = element.parentElement;
                            const errorDisplay = formGroup.querySelector('.errMsg');
                            if (errorDisplay) {
                                errorDisplay.innerText = message;
                                element.classList.add('success');
                                errorDisplay.classList.add('success');
                                element.classList.remove('error');
                                errorDisplay.classList.remove('error');
                            }
                        };

                        // Add Coupon Form
                        document.getElementById('addNewCouponForm').addEventListener('submit', async function (e) {
                            e.preventDefault();

                            const formData = {
                                couponId: document.getElementById('couponId').value.trim(),
                                discount: document.getElementById('discount').value.trim(),
                                description: document.getElementById('description').value.trim(),
                                expiryDate: document.getElementById('expiryDate').value.trim(),
                                min_purchase_amount: document.getElementById('min_purchase_amount').value.trim(),
                                max_amount: document.getElementById('max_amount').value.trim(),
                                is_active: document.getElementById('is_active').checked
                            };

                            if (!validateCouponForm(formData, 'add')) return;

                            try {
                                const response = await fetch('/admin/coupon/add', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({
                                        ...formData,
                                        discount: parseFloat(formData.discount),
                                        min_purchase_amount: parseFloat(formData.min_purchase_amount),
                                        max_amount: formData.max_amount ? parseFloat(formData.max_amount) : undefined
                                    })
                                });

                                const data = await response.json();

                                if (data.success) {
                                    const addModal = bootstrap.Modal.getInstance(document.getElementById('addCoupon'));
                                        if (addModal) addModal.hide();
                                    Swal.fire({
                                        title: 'Success!',
                                        text: data.message,
                                        icon: 'success',
                                        confirmButtonText: 'OK'
                                    }).then(() => window.location.href = data.redirectUrl);
                                } else {
                                    Swal.fire({
                                        title: 'Error!',
                                        text: data.message,
                                        icon: 'error',
                                        confirmButtonText: 'OK'
                                    });
                                }
                            } catch (error) {
                                Swal.fire({
                                    title: 'Error!',
                                    text: 'An error occurred while adding coupon',
                                    icon: 'error',
                                    confirmButtonText: 'OK'
                                });
                            }
                        });

                        // Edit Coupon Forms
                        document.querySelectorAll('.edit-coupon-form').forEach(form => {
                            form.addEventListener('submit', async function (e) {
                                e.preventDefault();
                                const couponID = this.getAttribute('data-coupon-id');

                                const formData = {
                                    id: couponID,
                                    couponId: document.getElementById(`couponId${couponID}`).value.trim(),
                                    discount: document.getElementById(`discount${couponID}`).value.trim(),
                                    description: document.getElementById(`description${couponID}`).value.trim(),
                                    expiryDate: document.getElementById(`expiryDate${couponID}`).value.trim(),
                                    min_purchase_amount: document.getElementById(`min_purchase_amount${couponID}`).value.trim(),
                                    max_amount: document.getElementById(`max_amount${couponID}`).value.trim(),
                                    is_active: document.getElementById(`is_active${couponID}`).checked
                                };

                                if (!validateCouponForm(formData, 'edit', couponID)) return;

                                try {
                                    const response = await fetch('/admin/coupon/update', {
                                        method: 'PUT',
                                        headers: { 'Content-Type': 'application/json' },
                                        body: JSON.stringify(formData)
                                    });

                                    const data = await response.json();

                                    if (data.success) {
                                            const editModal = bootstrap.Modal.getInstance(document.getElementById(`editCoupon${couponID}`));
                                                if (editModal) editModal.hide();
                                        Swal.fire({
                                            title: 'Success!',
                                            text: data.message,
                                            icon: 'success',
                                            confirmButtonText: 'OK'
                                        }).then(() => window.location.href = data.redirectUrl);
                                    } else {
                                        Swal.fire({
                                            title: 'Error!',
                                            text: data.message,
                                            icon: 'error',
                                            confirmButtonText: 'OK'
                                        });
                                    }
                                } catch (error) {
                                    Swal.fire({
                                        title: 'Error!',
                                        text: 'An error occurred while updating coupon',
                                        icon: 'error',
                                        confirmButtonText: 'OK'
                                    });
                                }
                            });
                        });

                        // Delete Coupon
                        document.querySelectorAll('.delete-coupon').forEach(button => {
                            button.addEventListener('click', async function () {
                                const couponId = this.getAttribute('data-coupon-id');

                                const result = await Swal.fire({
                                    title: 'Are you sure?',
                                    text: "You won't be able to revert this!",
                                    icon: 'warning',
                                    showCancelButton: true,
                                    confirmButtonColor: '#3085d6',
                                    cancelButtonColor: '#d33',
                                    confirmButtonText: 'Yes, delete it!'
                                });

                                if (result.isConfirmed) {
                                    try {
                                        const response = await fetch('/admin/coupon/delete', {
                                            method: 'DELETE',
                                            headers: { 'Content-Type': 'application/json' },
                                            body: JSON.stringify({ id: couponId })
                                        });

                                        const data = await response.json();

                                        if (data.success) {
                                            Swal.fire('Deleted!', 'Coupon has been deleted.', 'success')
                                                .then(() => location.reload());
                                        } else {
                                            Swal.fire('Error!', data.message, 'error');
                                        }
                                    } catch (error) {
                                        Swal.fire('Error!', 'An error occurred while deleting the coupon.', 'error');
                                    }
                                }
                            });
                        });

                        // Validation function
                        function validateCouponForm(data, mode, couponID = '') {
                            let isValid = true;
                            const nameRegex = /^[a-zA-Z0-9]+$/;
                            const suffix = mode === 'edit' ? couponID : '';

                            // Validate Coupon ID
                            const couponIdField = document.getElementById(`couponId${suffix}`);
                            if (!data.couponId) {
                                setError(couponIdField, 'Enter Coupon ID');
                                isValid = false;
                            } else if (!nameRegex.test(data.couponId)) {
                                setError(couponIdField, 'Coupon ID should only contain letters and numbers');
                                isValid = false;
                            } else if (data.couponId.length < 4) {
                                setError(couponIdField, 'Coupon ID should be minimum 4 characters');
                                isValid = false;
                            } else {
                                setSuccess(couponIdField, 'Coupon ID');
                            }

                            // Validate Discount
                            const discountField = document.getElementById(`discount${suffix}`);
                            if (!data.discount) {
                                setError(discountField, 'Enter Discount Amount');
                                isValid = false;
                            } else if (data.discount < 0 || data.discount > 100) {
                                setError(discountField, 'Discount should be between 0 and 100');
                                isValid = false;
                            } else {
                                setSuccess(discountField, 'Discount');
                            }

                            // Validate Description
                            const descriptionField = document.getElementById(`description${suffix}`);
                            if (!data.description) {
                                setError(descriptionField, 'Enter Description');
                                isValid = false;
                            } else if (data.description.length < 3) {
                                setError(descriptionField, 'Description should be at least 3 characters');
                                isValid = false;
                            } else {
                                setSuccess(descriptionField, 'Description');
                            }

                            // Validate Expiry Date
                            const expiryDateField = document.getElementById(`expiryDate${suffix}`);
                            if (!data.expiryDate) {
                                setError(expiryDateField, 'Select Expiry Date');
                                isValid = false;
                            } else {
                                const today = new Date();
                                today.setHours(0, 0, 0, 0);
                                const selectedDate = new Date(data.expiryDate);
                                if (selectedDate <= today) {
                                    setError(expiryDateField, 'Expiry date must be a future date');
                                    isValid = false;
                                } else {
                                    setSuccess(expiryDateField, 'Expiry Date');
                                }
                            }

                            // Validate Min Purchase Amount
                            const minPurchaseField = document.getElementById(`min_purchase_amount${suffix}`);
                            if (!data.min_purchase_amount) {
                                setError(minPurchaseField, 'Enter Minimum Purchase Amount');
                                isValid = false;
                            } else if (data.min_purchase_amount < 0) {
                                setError(minPurchaseField, 'Minimum Purchase Amount should be 0 or more');
                                isValid = false;
                            } else {
                                setSuccess(minPurchaseField, 'Minimum Purchase Amount');
                            }

                            // Validate Max Amount
                            const maxAmountField = document.getElementById(`max_amount${suffix}`);
                            if (data.max_amount) {
                                if (data.max_amount < 0) {
                                    setError(maxAmountField, 'Maximum Purchase Amount should be 0 or more');
                                    isValid = false;
                                } else if (parseFloat(data.max_amount) <= parseFloat(data.min_purchase_amount)) {
                                    setError(maxAmountField, 'Maximum Purchase Amount should be greater than Minimum');
                                    isValid = false;
                                } else {
                                    setSuccess(maxAmountField, 'Maximum Purchase Amount');
                                }
                            } else {
                                setSuccess(maxAmountField, 'Maximum Purchase Amount');
                            }

                            return isValid;
                        }
                    });
                </script>







</body>

