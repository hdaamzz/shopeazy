# ─────────────────────────────────────────────
#  ShopEazy — Environment Variables Example
#  Copy this file to .env and fill in your values
#  Never commit .env to version control
# ─────────────────────────────────────────────

# ── App ───────────────────────────────────────
PORT=3000
NODE_ENV=development          # development | production

# ── Session ───────────────────────────────────
SESSION_SECRET=your_strong_random_secret_here

# ── MongoDB ───────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<dbname>

# ── Nodemailer (Gmail SMTP) ───────────────────
# Used for OTP emails
SUPER_EMAIL=your_gmail@gmail.com
SUPER_PASS=your_gmail_app_password   # Gmail App Password (not your login password)
# To generate: Google Account → Security → 2-Step Verification → App Passwords

# ── Google OAuth 2.0 ──────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
# For production: change to https://yourdomain.com/auth/google/callback
# Also update Authorized redirect URIs in Google Cloud Console

# ── Razorpay ──────────────────────────────────
# Get from: https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
